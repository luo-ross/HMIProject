<Window x:Class="RS.SetupApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:converters="clr-namespace:RS.SetupApp.Converters"
        xmlns:views="clr-namespace:RS.SetupApp.Views"
        Title="{Binding ProductName}" Width="1180" Height="780" MinWidth="980" MinHeight="680"
        Background="{StaticResource CanvasBrush}" BorderThickness="0" Icon="{Binding WindowIcon}"
        WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" CornerRadius="0" GlassFrameThickness="-1" NonClientFrameEdges="None" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <DataTemplate x:Key="WelcomeTemplate"><views:WelcomePage DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" /></DataTemplate>
        <DataTemplate x:Key="LicenseTemplate"><views:LicensePage DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" /></DataTemplate>
        <DataTemplate x:Key="InstallOptionsTemplate"><views:InstallOptionsPage DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" /></DataTemplate>
        <DataTemplate x:Key="ReviewTemplate"><views:ReviewPage DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" /></DataTemplate>
        <DataTemplate x:Key="ProgressTemplate"><views:ProgressPage DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" /></DataTemplate>
        <DataTemplate x:Key="RecoveryTemplate"><views:RecoveryPage DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" /></DataTemplate>
        <DataTemplate x:Key="CompletionTemplate"><views:CompletionPage DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" /></DataTemplate>
        <DataTemplate x:Key="MaintenanceTemplate"><views:MaintenancePage DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" /></DataTemplate>
        <DataTemplate x:Key="UninstallConfirmationTemplate"><views:UninstallConfirmationPage DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" /></DataTemplate>
        <views:WizardPageTemplateSelector x:Key="WizardPageTemplateSelector"
                                          WelcomeTemplate="{StaticResource WelcomeTemplate}" LicenseTemplate="{StaticResource LicenseTemplate}"
                                          InstallOptionsTemplate="{StaticResource InstallOptionsTemplate}" ReviewTemplate="{StaticResource ReviewTemplate}"
                                          ProgressTemplate="{StaticResource ProgressTemplate}" RecoveryTemplate="{StaticResource RecoveryTemplate}"
                                          CompletionTemplate="{StaticResource CompletionTemplate}" MaintenanceTemplate="{StaticResource MaintenanceTemplate}"
                                          UninstallConfirmationTemplate="{StaticResource UninstallConfirmationTemplate}" />
    </Window.Resources>
    <Border Margin="14" Background="#F6F9FC" BorderBrush="#DCE6EE" BorderThickness="1" CornerRadius="12" Effect="{StaticResource WindowShadowEffect}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border BorderBrush="#E3EBF2" BorderThickness="0,0,0,1">
                <Grid Margin="20,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="10" Height="10" CornerRadius="5" Background="{Binding AccentBrush}" Margin="0,0,10,0" />
                        <TextBlock FontFamily="Segoe UI Variable Display" FontWeight="SemiBold" Foreground="{StaticResource TextStrongBrush}" Text="{Binding ProductName}" />
                        <TextBlock Margin="12,0,0,0" Foreground="{StaticResource TextMutedBrush}" Text="{Binding Publisher}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Margin="0,0,12,0">
                        <RadioButton Content="{Binding Ui.LanguageEnglishShort}" GroupName="UiLanguage" IsChecked="{Binding IsEnglishSelected}" Style="{StaticResource LanguageToggleStyle}"
                                     AutomationProperties.AutomationId="LanguageEnglish" AutomationProperties.Name="{Binding Ui.LanguageEnglishShort}" />
                        <RadioButton Content="{Binding Ui.LanguageChineseShort}" GroupName="UiLanguage" IsChecked="{Binding IsChineseSelected}" Style="{StaticResource LanguageToggleStyle}"
                                     AutomationProperties.AutomationId="LanguageChinese" AutomationProperties.Name="{Binding Ui.LanguageChineseShort}" />
                    </StackPanel>
                    <Button Grid.Column="2" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseWindow_Click" Background="Transparent" BorderThickness="0" Padding="12"
                            AutomationProperties.AutomationId="WindowClose" AutomationProperties.Name="{Binding Ui.CloseWindowAccessibleName}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE8BB;" />
                    </Button>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="244" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Background="#21333D" CornerRadius="12" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ProductName}" FontSize="22" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Publisher}" Margin="0,6,0,0" Foreground="#B8CDD1" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,42,0,0">
                            <TextBlock Text="{Binding Ui.RailWelcomeLabel}" Foreground="#D8F1EC" Margin="0,0,0,16" />
                            <TextBlock Text="{Binding Ui.RailConfigureLabel}" Foreground="#D8F1EC" Margin="0,0,0,16" />
                            <TextBlock Text="{Binding Ui.RailReviewLabel}" Foreground="#D8F1EC" Margin="0,0,0,16" />
                            <TextBlock Text="{Binding Ui.RailApplyLabel}" Foreground="#D8F1EC" Margin="0,0,0,16" />
                            <TextBlock Text="{Binding Ui.RailCompleteLabel}" Foreground="#D8F1EC" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="#C3D8DC" TextWrapping="Wrap" LineHeight="20" />
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="#DFE8F0" BorderThickness="1" CornerRadius="12" Padding="34">
                    <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}" ContentTemplateSelector="{StaticResource WizardPageTemplateSelector}" RenderTransformOrigin="0.5,0.5">
                        <ContentControl.RenderTransform><TranslateTransform /></ContentControl.RenderTransform>
                    </ContentControl>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
