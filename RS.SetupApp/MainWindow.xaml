<Window
    x:Class="RS.SetupApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:RS.SetupApp.Converters"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="{Binding ProductName}"
    Width="1180"
    Height="780"
    MinWidth="1180"
    MinHeight="780"
    BorderThickness="0"
    Background="{StaticResource CanvasBrush}"
    Icon="{Binding WindowIcon}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="64"
            CornerRadius="0"
            GlassFrameThickness="-1"
            NonClientFrameEdges="None"
            ResizeBorderThickness="5"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converters:WizardPageVisibilityConverter x:Key="WizardPageVisibilityConverter" />

        <Style x:Key="WindowCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FDEEEE" />
                                <Setter Property="Foreground" Value="#B42318" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FBD5D5" />
                                <Setter Property="Foreground" Value="#991B1B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border
        Margin="14"
        Background="#F6F9FC"
        BorderBrush="#DCE6EE"
        BorderThickness="1"
        Effect="{StaticResource WindowShadowEffect}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border BorderBrush="#E3EBF2" BorderThickness="0,0,0,1">
                <Grid Margin="24,18,24,14" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Border
                            Width="10"
                            Height="10"
                            Margin="0,0,10,0"
                            Background="{Binding AccentBrush}"
                            CornerRadius="5" />
                        <TextBlock
                            FontFamily="Segoe UI Variable Display"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextStrongBrush}"
                            Text="{Binding ProductName}" />
                        <TextBlock
                            Margin="12,0,0,0"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="{Binding Publisher}" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseWindow_Click"
                        Style="{StaticResource WindowCloseButtonStyle}">
                        <TextBlock
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            Text="&#xE8BB;" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.28*" />
                </Grid.ColumnDefinitions>

                <Border
                    Margin="24,0,10,24"
                    BorderBrush="#DCE6EE"
                    BorderThickness="1"
                    CornerRadius="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#FCFEFF" />
                            <GradientStop Offset="0.56" Color="#F3F8FC" />
                            <GradientStop Offset="1" Color="#EDF5F3" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Canvas IsHitTestVisible="False">
                            <Ellipse
                                Canvas.Top="-54"
                                Canvas.Right="-68"
                                Width="200"
                                Height="200"
                                Fill="#CDECEA"
                                Opacity="0.42" />
                            <Ellipse
                                Canvas.Left="-34"
                                Canvas.Bottom="58"
                                Width="164"
                                Height="164"
                                Fill="#DDEBF7"
                                Opacity="0.56" />
                        </Canvas>

                        <Grid Margin="32,28,30,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="34"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextStrongBrush}"
                                    Text="{Binding ProductName}" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    Foreground="{StaticResource TextBodyBrush}"
                                    Text="{Binding Publisher}" />
                                <Border
                                    Margin="0,18,0,0"
                                    Padding="12,5"
                                    HorizontalAlignment="Left"
                                    Background="{Binding AccentBrush}"
                                    CornerRadius="999">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{Binding InstalledVersion}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="{Binding Ui.LanguageSwitcherLabel}" />
                                <Border
                                    Margin="0,10,0,0"
                                    Padding="4"
                                    Background="#F1F5F9"
                                    BorderBrush="#D8E3EC"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton
                                            Content="{Binding Ui.LanguageEnglishShort}"
                                            GroupName="UiLanguage"
                                            IsChecked="{Binding IsEnglishSelected}"
                                            Style="{StaticResource LanguageToggleStyle}" />
                                        <RadioButton
                                            Content="{Binding Ui.LanguageChineseShort}"
                                            GroupName="UiLanguage"
                                            IsChecked="{Binding IsChineseSelected}"
                                            Style="{StaticResource LanguageToggleStyle}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="32,30,30,0">
                            <TextBlock
                                FontFamily="Segoe UI Variable Display"
                                FontSize="29"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextStrongBrush}"
                                Text="{Binding Ui.InstallerHeadline}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,16,0,0"
                                FontSize="15"
                                Foreground="{StaticResource TextBodyBrush}"
                                LineHeight="25"
                                Text="{Binding WelcomeText}"
                                TextWrapping="Wrap" />
                            <Border
                                Margin="0,28,0,0"
                                Padding="24"
                                Background="#FFFFFF"
                                BorderBrush="#DFE8F0"
                                BorderThickness="1"
                                CornerRadius="18"
                                Effect="{StaticResource CardShadowEffect}">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextStrongBrush}"
                                        Text="{Binding Ui.RuntimeStatusTitle}" />
                                    <TextBlock
                                        Margin="0,14,0,0"
                                        Foreground="{StaticResource TextBodyBrush}"
                                        LineHeight="24"
                                        Text="{Binding StatusMessage}"
                                        TextWrapping="Wrap" />
                                    <ProgressBar
                                        Height="12"
                                        Margin="0,18,0,0"
                                        Maximum="100"
                                        Value="{Binding ProgressValue, Mode=OneWay}" />
                                    <TextBlock
                                        Margin="0,16,0,0"
                                        Foreground="{StaticResource TextStrongBrush}"
                                        Text="{Binding RuntimeUpdateStatusText}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel
                            Grid.Row="2"
                            Margin="32,0,30,28"
                            Orientation="Horizontal">
                            <Button
                                Margin="0,0,10,0"
                                Click="Support_Click"
                                Content="{Binding SupportLinkText}"
                                Style="{StaticResource GhostButtonStyle}"
                                Visibility="{Binding HasSupportLink, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Button
                                Click="ReleaseNotes_Click"
                                Content="{Binding UpdateLinkText}"
                                Style="{StaticResource GhostButtonStyle}"
                                Visibility="{Binding HasUpdateLink, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    Margin="10,0,24,24"
                    Padding="30,28,30,24"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="#DFE8F0"
                    BorderThickness="1"
                    CornerRadius="0"
                    >
                    <Grid>
                        <Grid Visibility="{Binding CurrentPage, Converter={StaticResource WizardPageVisibilityConverter}, ConverterParameter=Welcome}">
                            <StackPanel>
                                <TextBlock
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="32"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextStrongBrush}"
                                    Text="{Binding Ui.WelcomeTitle}" />
                                <TextBlock
                                    Margin="0,16,0,0"
                                    FontSize="15"
                                    Foreground="{StaticResource TextBodyBrush}"
                                    LineHeight="25"
                                    Text="{Binding Ui.WelcomeIntroText}"
                                    TextWrapping="Wrap" />
                                <Border
                                    Margin="0,28,0,0"
                                    Padding="22"
                                    Background="{StaticResource SurfaceSoftBrush}"
                                    BorderBrush="{StaticResource StrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="17"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextStrongBrush}"
                                            Text="{Binding Ui.WelcomeChecklistTitle}" />
                                        <TextBlock
                                            Margin="0,14,0,0"
                                            Foreground="{StaticResource TextBodyBrush}"
                                            Text="{Binding Ui.WelcomeChecklistStepOne}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Margin="0,10,0,0"
                                            Foreground="{StaticResource TextBodyBrush}"
                                            Text="{Binding Ui.WelcomeChecklistStepTwo}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Margin="0,10,0,0"
                                            Foreground="{StaticResource TextBodyBrush}"
                                            Text="{Binding Ui.WelcomeChecklistStepThree}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="0,34,0,0" Orientation="Horizontal">
                                    <Button
                                        Background="{Binding AccentBrush}"
                                        Click="WelcomeContinue_Click"
                                        Content="{Binding Ui.ContinueButtonText}"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid Visibility="{Binding CurrentPage, Converter={StaticResource WizardPageVisibilityConverter}, ConverterParameter=License}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                FontFamily="Segoe UI Variable Display"
                                FontSize="32"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextStrongBrush}"
                                Text="{Binding Ui.LicenseTitle}" />
                            <TextBox
                                Grid.Row="1"
                                Margin="0,20,0,0"
                                AcceptsReturn="True"
                                IsReadOnly="True"
                                Style="{StaticResource ModernTextBoxStyle}"
                                Text="{Binding LicenseText, Mode=OneWay}"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />
                            <StackPanel Grid.Row="2" Margin="0,18,0,0">
                                <CheckBox
                                    Content="{Binding Ui.AcceptLicenseText}"
                                    IsChecked="{Binding AcceptLicense}"
                                    Style="{StaticResource ModernCheckBoxStyle}" />
                                <StackPanel Margin="0,30,0,0" Orientation="Horizontal">
                                    <Button
                                        Margin="0,0,10,0"
                                        Click="LicenseBack_Click"
                                        Content="{Binding Ui.BackButtonText}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button
                                        Background="{Binding AccentBrush}"
                                        Click="LicenseContinue_Click"
                                        Content="{Binding Ui.ContinueButtonText}"
                                        IsEnabled="{Binding CanExecuteAction}"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid Visibility="{Binding CurrentPage, Converter={StaticResource WizardPageVisibilityConverter}, ConverterParameter=InstallOptions}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                FontFamily="Segoe UI Variable Display"
                                FontSize="30"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextStrongBrush}"
                                Text="{Binding Ui.InstallOptionsTitle}" />
                            <Grid Grid.Row="1" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock
                                        Foreground="{StaticResource TextBodyBrush}"
                                        LineHeight="22"
                                        Text="{Binding Ui.InstallOptionsSubtitle}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,18,0,0"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextStrongBrush}"
                                        Text="{Binding Ui.InstallScopeLabel}" />
                                    <StackPanel Margin="0,10,0,0">
                                        <RadioButton
                                            GroupName="InstallScope"
                                            IsChecked="{Binding InstallForAllUsers, Converter={StaticResource InverseBooleanConverter}}"
                                            Style="{StaticResource CompactOptionCardRadioButtonStyle}">
                                            <StackPanel>
                                                <TextBlock
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource TextStrongBrush}"
                                                    Text="{Binding Ui.InstallScopeCurrentUserTitle}" />
                                                <TextBlock
                                                    Margin="0,6,0,0"
                                                    Foreground="{StaticResource TextBodyBrush}"
                                                    Text="{Binding Ui.InstallScopeCurrentUserDescription}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                    <StackPanel Margin="0,8,0,0">
                                        <RadioButton
                                            GroupName="InstallScope"
                                            IsChecked="{Binding InstallForAllUsers}"
                                            IsEnabled="{Binding AllowMachineInstall}"
                                            Style="{StaticResource CompactOptionCardRadioButtonStyle}">
                                            <StackPanel>
                                                <TextBlock
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource TextStrongBrush}"
                                                    Text="{Binding Ui.InstallScopeAllUsersTitle}" />
                                                <TextBlock
                                                    Margin="0,6,0,0"
                                                    Foreground="{StaticResource TextBodyBrush}"
                                                    Text="{Binding Ui.InstallScopeAllUsersDescription}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>

                                    <TextBlock
                                        Margin="0,18,0,0"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextStrongBrush}"
                                        Text="{Binding Ui.InstallDirectoryLabel}" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            IsEnabled="{Binding CanChangeInstallDirectory}"
                                            Style="{StaticResource CompactTextBoxStyle}"
                                            Text="{Binding InstallDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            Click="BrowseInstallDirectory_Click"
                                            Content="{Binding Ui.BrowseButtonText}"
                                            IsEnabled="{Binding CanChangeInstallDirectory}"
                                            Style="{StaticResource CompactSecondaryButtonStyle}" />
                                        <Button
                                            Grid.Column="2"
                                            Margin="8,0,0,0"
                                            Click="ResetInstallDirectory_Click"
                                            Content="{Binding Ui.ResetButtonText}"
                                            IsEnabled="{Binding CanChangeInstallDirectory}"
                                            Style="{StaticResource CompactSecondaryButtonStyle}" />
                                    </Grid>
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        Text="{Binding InstallDirectoryHintText}"
                                        TextWrapping="Wrap" />

                                    <Border
                                        Margin="0,16,0,0"
                                        Padding="16"
                                        Background="{StaticResource SurfaceSoftBrush}"
                                        BorderBrush="{StaticResource StrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                        <StackPanel>
                                            <CheckBox
                                                Content="{Binding Ui.CreateShortcutsText}"
                                                IsChecked="{Binding CreateShortcuts}"
                                                Style="{StaticResource ModernCheckBoxStyle}" />
                                            <CheckBox
                                                Margin="0,12,0,0"
                                                Content="{Binding Ui.EnableAutoStartText}"
                                                IsChecked="{Binding EnableAutoStart}"
                                                Style="{StaticResource ModernCheckBoxStyle}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <Border
                                Grid.Row="2"
                                Margin="0,16,0,0"
                                Padding="0,16,0,0"
                                BorderBrush="#E3EBF2"
                                BorderThickness="0,1,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Margin="0,0,10,0"
                                        Click="InstallBack_Click"
                                        Content="{Binding Ui.BackButtonText}"
                                        Style="{StaticResource CompactSecondaryButtonStyle}" />
                                    <Button
                                        Background="{Binding AccentBrush}"
                                        Click="InstallStart_Click"
                                        Content="{Binding InstallPrimaryActionText}"
                                        IsEnabled="{Binding CanExecuteAction}"
                                        Style="{StaticResource CompactPrimaryButtonStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Visibility="{Binding CurrentPage, Converter={StaticResource WizardPageVisibilityConverter}, ConverterParameter=Progress}">
                            <StackPanel>
                                <TextBlock
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="32"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextStrongBrush}"
                                    Text="{Binding Ui.ApplyingSetupTitle}" />
                                <TextBlock
                                    Margin="0,16,0,0"
                                    Foreground="{StaticResource TextBodyBrush}"
                                    LineHeight="24"
                                    Text="{Binding Ui.ApplyingSetupDescription}"
                                    TextWrapping="Wrap" />
                                <Border
                                    Margin="0,28,0,0"
                                    Padding="22"
                                    Background="{StaticResource SurfaceSoftBrush}"
                                    BorderBrush="{StaticResource StrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18">
                                    <StackPanel>
                                        <ProgressBar
                                            Height="18"
                                            Maximum="100"
                                            Value="{Binding ProgressValue, Mode=OneWay}" />
                                        <TextBlock
                                            Margin="0,18,0,0"
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextStrongBrush}"
                                            Text="{Binding ProgressValue, StringFormat={}{0:F0}%}" />
                                        <TextBlock
                                            Margin="0,12,0,0"
                                            Foreground="{StaticResource TextBodyBrush}"
                                            LineHeight="24"
                                            Text="{Binding StatusMessage}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Visibility="{Binding CurrentPage, Converter={StaticResource WizardPageVisibilityConverter}, ConverterParameter=Complete}">
                            <StackPanel>
                                <TextBlock
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="32"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextStrongBrush}"
                                    Text="{Binding Ui.CompletedTitle}" />
                                <TextBlock
                                    Margin="0,18,0,0"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextStrongBrush}"
                                    Text="{Binding CompletionMessage}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,14,0,0"
                                    Foreground="{StaticResource TextBodyBrush}"
                                    LineHeight="24"
                                    Text="{Binding StatusMessage}"
                                    TextWrapping="Wrap" />
                                <StackPanel Margin="0,32,0,0" Orientation="Horizontal">
                                    <Button
                                        Margin="0,0,10,0"
                                        Background="{Binding AccentBrush}"
                                        Click="LaunchInstalledApp_Click"
                                        Content="{Binding Ui.LaunchAppButtonText}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Visibility="{Binding CanLaunchInstalledApplication, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <Button
                                        Click="CompleteClose_Click"
                                        Content="{Binding Ui.FinishButtonText}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid Visibility="{Binding CurrentPage, Converter={StaticResource WizardPageVisibilityConverter}, ConverterParameter=Maintenance}">
                            <StackPanel>
                                <TextBlock
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="32"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextStrongBrush}"
                                    Text="{Binding Ui.MaintenanceTitle}" />
                                <TextBlock
                                    Margin="0,14,0,0"
                                    Foreground="{StaticResource TextBodyBrush}"
                                    LineHeight="24"
                                    Text="{Binding Ui.MaintenanceDescription}"
                                    TextWrapping="Wrap" />
                                <Border
                                    Margin="0,24,0,0"
                                    Padding="22"
                                    Background="{StaticResource SurfaceSoftBrush}"
                                    BorderBrush="{StaticResource StrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18">
                                    <StackPanel>
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextStrongBrush}"
                                            Text="{Binding MaintenanceInstalledVersionText}" />
                                        <TextBlock
                                            Margin="0,10,0,0"
                                            Foreground="{StaticResource TextBodyBrush}"
                                            Text="{Binding InstallDirectory}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Margin="0,10,0,0"
                                            Foreground="{StaticResource TextBodyBrush}"
                                            Text="{Binding RuntimeUpdateStatusText}" />
                                    </StackPanel>
                                </Border>
                                <WrapPanel Margin="0,30,0,0">
                                    <Button
                                        Margin="0,0,10,10"
                                        Click="MaintenanceRepair_Click"
                                        Content="{Binding Ui.RepairButtonText}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button
                                        Margin="0,0,10,10"
                                        Click="MaintenanceCheckUpdate_Click"
                                        Content="{Binding Ui.CheckUpdateButtonText}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button
                                        Margin="0,0,10,10"
                                        Background="{Binding AccentBrush}"
                                        Click="MaintenanceUpdate_Click"
                                        Content="{Binding Ui.OpenUpdateButtonText}"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button
                                        Margin="0,0,10,10"
                                        Click="MaintenanceReinstall_Click"
                                        Content="{Binding Ui.InstallOptionsButtonText}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button
                                        Margin="0,0,10,10"
                                        Click="MaintenanceUninstall_Click"
                                        Content="{Binding Ui.UninstallButtonText}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>

                        <Grid Visibility="{Binding CurrentPage, Converter={StaticResource WizardPageVisibilityConverter}, ConverterParameter=Update}">
                            <StackPanel>
                                <TextBlock
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="32"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextStrongBrush}"
                                    Text="{Binding Ui.UpdateTitle}" />
                                <TextBlock
                                    Margin="0,18,0,0"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextStrongBrush}"
                                    Text="{Binding UpdateAvailableVersionText}" />
                                <Border
                                    Margin="0,20,0,0"
                                    Padding="20"
                                    Background="{StaticResource SurfaceSoftBrush}"
                                    BorderBrush="{StaticResource StrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16">
                                    <TextBlock
                                        Foreground="{StaticResource TextBodyBrush}"
                                        LineHeight="24"
                                        Text="{Binding AvailableUpdateNotes}"
                                        TextWrapping="Wrap" />
                                </Border>
                                <StackPanel Margin="0,32,0,0" Orientation="Horizontal">
                                    <Button
                                        Margin="0,0,10,0"
                                        Click="UpdateBack_Click"
                                        Content="{Binding Ui.BackButtonText}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button
                                        Background="{Binding AccentBrush}"
                                        Click="UpdateStart_Click"
                                        Content="{Binding Ui.UpdateNowButtonText}"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid Visibility="{Binding CurrentPage, Converter={StaticResource WizardPageVisibilityConverter}, ConverterParameter=UninstallConfirm}">
                            <StackPanel>
                                <TextBlock
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="32"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextStrongBrush}"
                                    Text="{Binding Ui.UninstallTitle}" />
                                <TextBlock
                                    Margin="0,16,0,0"
                                    Foreground="{StaticResource TextBodyBrush}"
                                    LineHeight="24"
                                    Text="{Binding Ui.UninstallDescription}"
                                    TextWrapping="Wrap" />
                                <Border
                                    Margin="0,24,0,0"
                                    Padding="20"
                                    Background="{StaticResource SurfaceSoftBrush}"
                                    BorderBrush="{StaticResource StrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16">
                                    <CheckBox
                                        Content="{Binding Ui.PurgeDataText}"
                                        IsChecked="{Binding PurgeData}"
                                        Style="{StaticResource ModernCheckBoxStyle}" />
                                </Border>
                                <StackPanel Margin="0,32,0,0" Orientation="Horizontal">
                                    <Button
                                        Margin="0,0,10,0"
                                        Click="UninstallBack_Click"
                                        Content="{Binding Ui.BackButtonText}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button
                                        Background="{Binding AccentBrush}"
                                        Click="UninstallStart_Click"
                                        Content="{Binding Ui.UninstallButtonText}"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
