<UserControl x:Class="RS.SetupApp.Views.CompletionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel><TextBlock Text="{Binding Ui.CompletedTitle}" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TextStrongBrush}" />
        <TextBlock Text="{Binding CompletionMessage}" Margin="0,16,0,0" Foreground="{StaticResource TextBodyBrush}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Maintenance.CanonicalInstallRoot}" Margin="0,16,0,0" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Maintenance.InstalledVersion}" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,30,0,0"><Button Command="{Binding LaunchInstalledApplicationCommand}" Content="{Binding Ui.LaunchAppButtonText}" Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.AutomationId="CompletionLaunch" AutomationProperties.Name="{Binding Ui.LaunchAppButtonText}" />
            <Button Command="{Binding OpenLogCommand}" Content="{Binding Ui.OpenLogButtonText}" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" AutomationProperties.AutomationId="CompletionOpenLog" AutomationProperties.Name="{Binding Ui.OpenLogButtonText}" />
            <Button Command="{Binding FinishCommand}" Content="{Binding Ui.FinishButtonText}" Style="{StaticResource PrimaryButtonStyle}" Background="{Binding AccentBrush}" Margin="10,0,0,0" AutomationProperties.AutomationId="CompletionFinish" AutomationProperties.Name="{Binding Ui.FinishButtonText}" /></StackPanel>
    </StackPanel>
</UserControl>
