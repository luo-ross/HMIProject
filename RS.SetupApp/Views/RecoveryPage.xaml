<UserControl x:Class="RS.SetupApp.Views.RecoveryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel><TextBlock Text="{Binding Ui.RecoveryTitle}" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TextStrongBrush}" />
        <TextBlock Text="{Binding Recovery.Message}" Margin="0,16,0,0" Foreground="{StaticResource TextBodyBrush}" TextWrapping="Wrap" />
        <ListBox ItemsSource="{Binding Recovery.Errors}" Margin="0,16,0,0" BorderThickness="0" Background="{StaticResource SurfaceSoftBrush}" AutomationProperties.AutomationId="RecoveryErrors" AutomationProperties.Name="{Binding Ui.RecoveryErrorsAccessibleName}" />
        <StackPanel Orientation="Horizontal" Margin="0,28,0,0"><Button Command="{Binding Recovery.RetryCommand}" Content="{Binding Ui.RecoveryRetryButtonText}" Style="{StaticResource PrimaryButtonStyle}" Background="{Binding AccentBrush}" AutomationProperties.AutomationId="RecoveryRetry" AutomationProperties.Name="{Binding Ui.RecoveryRetryButtonText}" />
            <Button Command="{Binding OpenLogCommand}" Content="{Binding Ui.OpenLogButtonText}" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" AutomationProperties.AutomationId="RecoveryOpenLog" AutomationProperties.Name="{Binding Ui.OpenLogButtonText}" /></StackPanel>
    </StackPanel>
</UserControl>
