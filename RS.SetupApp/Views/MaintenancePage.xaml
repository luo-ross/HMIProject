<UserControl x:Class="RS.SetupApp.Views.MaintenancePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding Ui.MaintenanceTitle}" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TextStrongBrush}" />
        <TextBlock Text="{Binding Ui.MaintenanceDescription}" Margin="0,14,0,0" Foreground="{StaticResource TextBodyBrush}" TextWrapping="Wrap" />
        <Border Margin="0,22,0,0" Padding="18" Background="{StaticResource SurfaceSoftBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="12"><StackPanel>
            <TextBlock Text="{Binding Maintenance.InstalledVersion}" FontWeight="SemiBold" /><TextBlock Text="{Binding Maintenance.CanonicalInstallRoot}" Margin="0,8,0,0" TextWrapping="Wrap" /></StackPanel></Border>
        <UniformGrid Columns="2" Margin="0,24,0,0"><Button Command="{Binding RepairCommand}" Content="{Binding Ui.RepairButtonText}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,10" AutomationProperties.AutomationId="MaintenanceRepair" AutomationProperties.Name="{Binding Ui.RepairButtonText}" />
            <Button Command="{Binding CheckForUpdatesCommand}" Content="{Binding Ui.CheckUpdateButtonText}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,10" AutomationProperties.AutomationId="MaintenanceCheckUpdates" AutomationProperties.Name="{Binding Ui.CheckUpdateButtonText}" />
            <Button Command="{Binding UpdateCommand}" Content="{Binding Ui.UpdateNowButtonText}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" AutomationProperties.AutomationId="MaintenanceUpdate" AutomationProperties.Name="{Binding Ui.UpdateNowButtonText}" />
            <Button Command="{Binding OpenInstallOptionsCommand}" Content="{Binding Ui.InstallOptionsButtonText}" Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.AutomationId="MaintenanceOptions" AutomationProperties.Name="{Binding Ui.InstallOptionsButtonText}" /></UniformGrid>
        <Button Command="{Binding ShowUninstallConfirmationCommand}" Content="{Binding Ui.UninstallButtonText}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,16,0,0" HorizontalAlignment="Left" AutomationProperties.AutomationId="MaintenanceUninstall" AutomationProperties.Name="{Binding Ui.UninstallButtonText}" />
        <Border Margin="0,22,0,0" Padding="16" Background="#FFF8E7" BorderBrush="#E8C66A" BorderThickness="1" CornerRadius="12" Visibility="{Binding Maintenance.HasLegacyInstallationToClaim, Converter={StaticResource BoolToVisibilityConverter}}"><StackPanel>
            <TextBlock Text="{Binding Ui.LegacyClaimDescription}" TextWrapping="Wrap" /><TextBlock Text="{Binding Maintenance.CanonicalInstallRoot}" Margin="0,8,0,0" TextWrapping="Wrap" />
            <Button Command="{Binding Maintenance.ClaimLegacyInstallationCommand}" Content="{Binding Ui.LegacyClaimButtonText}" Style="{StaticResource PrimaryButtonStyle}" Background="{Binding AccentBrush}" Margin="0,14,0,0" HorizontalAlignment="Left" AutomationProperties.AutomationId="ClaimLegacyInstallation" AutomationProperties.Name="{Binding Ui.LegacyClaimButtonText}" /></StackPanel></Border>
    </StackPanel></ScrollViewer>
</UserControl>
