<UserControl x:Class="RS.SetupApp.Views.ProgressPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="{Binding Ui.ApplyingSetupTitle}" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TextStrongBrush}" />
        <StackPanel Grid.Row="1" Margin="0,18,0,0"><TextBlock Text="{Binding Progress.CurrentStep}" Foreground="{StaticResource TextBodyBrush}" TextWrapping="Wrap" />
            <ProgressBar Height="12" Margin="0,12,0,0" Maximum="100" Value="{Binding Progress.Percent}" /></StackPanel>
        <Grid Grid.Row="2" Margin="0,24,0,0"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ListBox ItemsSource="{Binding Progress.CompletedSteps}" BorderThickness="0" Background="Transparent" AutomationProperties.AutomationId="ProgressTimeline" AutomationProperties.Name="{Binding Ui.ProgressTimelineAccessibleName}" />
            <Expander Grid.Row="1" Header="{Binding Ui.LogDetailsLabel}" IsExpanded="{Binding Progress.IsLogExpanded}" Margin="0,14,0,0" AutomationProperties.AutomationId="ProgressLogDetails" AutomationProperties.Name="{Binding Ui.LogDetailsLabel}"><StackPanel><TextBlock Text="{Binding Progress.LogPath}" TextWrapping="Wrap" />
                <Button Command="{Binding OpenLogCommand}" Content="{Binding Ui.OpenLogButtonText}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,10,0,0" HorizontalAlignment="Left" AutomationProperties.AutomationId="ProgressOpenLog" AutomationProperties.Name="{Binding Ui.OpenLogButtonText}" /></StackPanel></Expander></Grid>
        <Button Grid.Row="3" Command="{Binding CancelCommand}" Content="{Binding CancelLabel}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,20,0,0" HorizontalAlignment="Left" AutomationProperties.AutomationId="ProgressCancel" AutomationProperties.Name="{Binding CancelLabel}" />
    </Grid>
</UserControl>
