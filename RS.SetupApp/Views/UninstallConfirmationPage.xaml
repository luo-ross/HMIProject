<UserControl x:Class="RS.SetupApp.Views.UninstallConfirmationPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel><TextBlock Text="{Binding Ui.UninstallTitle}" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TextStrongBrush}" />
        <TextBlock Text="{Binding Ui.UninstallDescription}" Margin="0,16,0,0" Foreground="{StaticResource TextBodyBrush}" LineHeight="24" TextWrapping="Wrap" />
        <CheckBox Content="{Binding Ui.PurgeDataText}" IsChecked="{Binding InstallOptions.PurgeData}" Style="{StaticResource ModernCheckBoxStyle}" Margin="0,24,0,0" AutomationProperties.AutomationId="UninstallPurgeData" AutomationProperties.Name="{Binding Ui.PurgeDataText}" />
        <StackPanel Orientation="Horizontal" Margin="0,30,0,0"><Button Command="{Binding BackCommand}" Content="{Binding Ui.BackButtonText}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" AutomationProperties.AutomationId="UninstallBack" AutomationProperties.Name="{Binding Ui.BackButtonText}" />
            <Button Command="{Binding UninstallCommand}" Content="{Binding Ui.UninstallButtonText}" Style="{StaticResource PrimaryButtonStyle}" Background="#B42318" AutomationProperties.AutomationId="UninstallConfirm" AutomationProperties.Name="{Binding Ui.UninstallButtonText}" /></StackPanel>
    </StackPanel>
</UserControl>
