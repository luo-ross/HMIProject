<UserControl
    x:Class="RS.WPFClient.Controls.RSMailDetail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="clr-namespace:RS.WPFClient.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:RS.WPFClient.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rs="https://github.com/luo-ross/MultiVerseKit"
    xmlns:web="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    x:Name="this"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converter:FirstCharConverter x:Key="FirstCharConverter" />
    </UserControl.Resources>
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!--  Subject  -->
            <RowDefinition Height="Auto" /> <!--  Metadata & Actions  -->
            <RowDefinition Height="Auto" /> <!--  Translation/Notice bar  -->
            <RowDefinition Height="*" />    <!--  Html Content  -->
        </Grid.RowDefinitions>

        <!--  Title Area  -->
        <Grid Grid.Row="0" Margin="25,20,25,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="#333"
                    Text="{Binding Subject}" />
                <rs:RSButton
                    Margin="10,0,0,0"
                    Padding="2"
                    rs:ControlsHelper.IconData="{StaticResource RSApp.Icons.Email.StarOutline}"
                    rs:ControlsHelper.IconHeight="16"
                    rs:ControlsHelper.IconWidth="16"
                    Background="Transparent"
                    BorderThickness="0" />
            </StackPanel>
        </Grid>

        <!--  Metadata & Info Area  -->
        <Grid Grid.Row="1" Margin="25,5,25,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Avatar  -->
            <Border
                Grid.Column="0"
                Width="36"
                Height="36"
                VerticalAlignment="Top"
                Background="#9d7cf7"
                CornerRadius="18">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="White"
                    Text="{Binding Account, Converter={StaticResource FirstCharConverter}}" />
            </Border>

            <!--  Details  -->
            <StackPanel
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="#333"
                        Text="{Binding Account}" />
                    <TextBlock
                        Margin="5,0,0,0"
                        Foreground="#888"
                        Text="noreply@github.com 代发" />
                </StackPanel>
                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                    <TextBlock Foreground="#888" Text="发件人" />
                    <TextBlock
                        Margin="10,0,0,0"
                        Foreground="#444"
                        Text="{Binding Account}" />
                    <TextBlock
                        Margin="5,0,0,0"
                        Foreground="#888"
                        Text="{Binding Email, StringFormat='&lt;{0}&gt;'}" />
                </StackPanel>
                <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                    <TextBlock Foreground="#888" Text="收件人" />
                    <TextBlock
                        Margin="10,0,0,0"
                        Foreground="#444"
                        Text="行云游者 &lt;1845960295@qq.com&gt;" />
                </StackPanel>
                <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                    <TextBlock Foreground="#888" Text="时间" />
                    <TextBlock
                        Margin="22,0,0,0"
                        Foreground="#444"
                        Text="{Binding Time, StringFormat='{}{0:yyyy年MM月dd日 HH:mm}'}" />
                </StackPanel>
            </StackPanel>

            <!--  Action Buttons  -->
            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Orientation="Horizontal">
                <rs:RSButton
                    rs:ControlsHelper.IconData="{StaticResource RSApp.Icons.Email.Reply}"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTip="回复" />
                <rs:RSButton
                    Margin="5,0,0,0"
                    rs:ControlsHelper.IconData="{StaticResource RSApp.Icons.Printer}"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTip="打印" />
                <rs:RSButton
                    Margin="5,0,0,0"
                    rs:ControlsHelper.IconData="{StaticResource RSApp.Icons.Email.Forward}"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTip="转发" />
                <rs:RSDropdown
                    Margin="10,0,0,0"
                    BorderThickness="0"
                    Content="更多操作"
                    FontSize="12"
                    Foreground="#666"
                    IsShowDropDownIcon="True" />
            </StackPanel>
        </Grid>

        <!--  Notice Area (Mockup)  -->
        <Border
            Grid.Row="2"
            Margin="20,0,20,10"
            Padding="12,8"
            Background="#f0f7ff"
            CornerRadius="4">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <rs:RSButton
                        rs:ControlsHelper.IconData="{StaticResource RSApp.Icons.Translate}"
                        rs:ControlsHelper.IconHeight="14"
                        rs:ControlsHelper.IconWidth="14"
                        Background="Transparent"
                        BorderThickness="0" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#666"
                        Text="邮件可翻译为中文" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        FontSize="12"
                        Foreground="#0078d4"
                        Text="全文翻译" />
                </StackPanel>
                <rs:RSButton
                    HorizontalAlignment="Right"
                    rs:ControlsHelper.IconData="{StaticResource RSApp.Icons.Close}"
                    rs:ControlsHelper.IconHeight="12"
                    rs:ControlsHelper.IconWidth="12"
                    Background="Transparent"
                    BorderThickness="0" />
            </Grid>
        </Border>

        <!--  WebView Area  -->
        <Border
            Grid.Row="3"
            Margin="20,0,20,20"
            BorderBrush="#f0f0f0"
            BorderThickness="1">
            <web:WebView2 rs:WebView2Helper.HtmlContent="{Binding Content}" rs:WebView2Helper.OpenExternalLinks="True" />
        </Border>
    </Grid>
</UserControl>
