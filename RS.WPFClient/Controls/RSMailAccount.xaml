<UserControl
    x:Class="RS.WPFClient.Controls.RSMailAccount"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:RS.WPFClient.Behaviors"
    xmlns:converter="clr-namespace:RS.WPFClient.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:RS.WPFClient.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rs="https://github.com/luo-ross/MultiVerseKit"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converter:MailModelLimitItemsConverter x:Key="MailModelLimitItemsConverter" />
        <converter:FirstCharConverter x:Key="FirstCharConverter" />
    </UserControl.Resources>

    <Grid x:Name="PART_AccountContainer" Background="Transparent">
        <i:Interaction.Behaviors>
            <behavior:HoverPopupBehavior Popup="{Binding ElementName=PART_AccountPopup}" />
        </i:Interaction.Behaviors>
        <TextBlock
            x:Name="PART_TxtAccount"
            Margin="5,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            FontSize="14"
            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
            Text="{Binding Account, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
            TextTrimming="CharacterEllipsis" />
        <Popup
            x:Name="PART_AccountPopup"
            Width="450"
            AllowsTransparency="True"
            Placement="Right"
            PlacementTarget="{Binding ElementName=PART_TxtAccount}"
            PopupAnimation="Fade">
            <Border
                Margin="15,0,15,15"
                Background="#fff"
                BorderBrush="{StaticResource RSApp.Styles.BaseGray007}"
                BorderThickness="1"
                CornerRadius="5"
                Effect="{StaticResource RSApp.Styles.DefaultEffect}">
                <StackPanel>
                    <Grid Margin="16,16,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="50"
                            Height="50"
                            HorizontalAlignment="Left"
                            Background="{StaticResource RSApp.Styles.BaseGray010}"
                            CornerRadius="25">
                            <Grid>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="24"
                                    Foreground="White"
                                    Text="{Binding Account, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource FirstCharConverter}}" />
                                <Image Source="{Binding Avatar, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Stretch="UniformToFill">
                                    <Image.Clip>
                                        <EllipseGeometry
                                            Center="25,25"
                                            RadiusX="25"
                                            RadiusY="25" />
                                    </Image.Clip>
                                </Image>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">

                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    Padding="0"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource RSApp.Styles.BaseGray090}"
                                    Text="{Binding Account, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                                <Button
                                    Margin="5,0,0,0"
                                    Padding="3,5,3,5"
                                    rs:ControlsHelper.IconData="M3 3h10v12l-5-3-5 3z"
                                    rs:ControlsHelper.IconHeight="14"
                                    rs:ControlsHelper.IconWidth="14"
                                    Style="{StaticResource RSApp.Styles.IconButtonStyle}" />
                            </StackPanel>

                            <StackPanel
                                x:Name="EmailArea"
                                Height="28"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="EmailText"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="PART_EmailText_Click"
                                    Cursor="Hand"
                                    Style="{StaticResource RSApp.Styles.ButtonBaseStyle}"
                                    ToolTip="给TA写信">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        FontSize="14"
                                        Foreground="{StaticResource RSApp.Styles.BaseGray060}"
                                        Text="{Binding Email, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=EmailArea}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Underline" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button
                                    x:Name="PART_BtnCopyEmail"
                                    Padding="3,5,3,5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    rs:ControlsHelper.IconData="{StaticResource RSApp.Icons.DragDropCopy}"
                                    rs:ControlsHelper.IconHeight="12"
                                    rs:ControlsHelper.IconWidth="12"
                                    Click="PART_BtnCopyEmail_Click"
                                    Style="{StaticResource RSApp.Styles.IconButtonStyle}"
                                    ToolTip="复制邮箱地址"
                                    Visibility="Collapsed" />

                                <StackPanel.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_BtnCopyEmail" Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_BtnCopyEmail" Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </StackPanel.Triggers>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="16,20,16,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            Margin="0,0,4,0"
                            HorizontalContentAlignment="Center"
                            Content="+ 添加联系人"
                            Style="{StaticResource RSApp.Styles.PrimaryButton}" />
                        <Button
                            Grid.Column="1"
                            Margin="4,0,4,0"
                            Content="归档至..."
                            Style="{StaticResource RSApp.Styles.DefaultButton}" />
                        <Button
                            Grid.Column="2"
                            Margin="4,0,0,0"
                            Content="拒收"
                            Style="{StaticResource RSApp.Styles.DefaultButton}" />
                    </Grid>

                    <Separator Height="1" Background="{StaticResource RSApp.Styles.BaseGray007}" />

                    <Grid Margin="15,5,10,0">
                        <TextBlock
                            FontWeight="Bold"
                            Foreground="{StaticResource RSApp.Styles.BaseGray080}"
                            Text="最近往来" />

                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button
                                x:Name="PART_BtnViewAll"
                                Padding="0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="PART_BtnViewAll_Click"
                                Cursor="Hand"
                                Style="{StaticResource RSApp.Styles.ButtonBaseStyle}">
                                <TextBlock
                                    x:Name="PART_TxtViewAll"
                                    VerticalAlignment="Center"
                                    Cursor="Hand"
                                    FontSize="14"
                                    Foreground="{StaticResource RSApp.Styles.BaseGray060}"
                                    Text="查看全部"
                                    TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="TextDecorations" Value="Underline" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>

                            <Path
                                Width="8"
                                Height="12"
                                Margin="0,0,0,1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="{StaticResource RSApp.Icons.RightArrow}"
                                Fill="{Binding ElementName=PART_TxtViewAll, Path=Foreground}"
                                Stretch="Fill" />
                        </StackPanel>

                    </Grid>

                    <ItemsControl Margin="5,10,5,5">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="ItemsSource" Value="{x:Null}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOpen, ElementName=PART_AccountPopup}" Value="True">
                                        <Setter Property="ItemsSource">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource MailModelLimitItemsConverter}" ConverterParameter="3">
                                                    <Binding Path="RecentInteractions" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                                                    <Binding Path="Account" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    x:Name="PART_Border"
                                    Background="Transparent"
                                    CornerRadius="5">
                                    <!--<Grid Margin="10,5,10,5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            FontSize="14"
                                            Text="{Binding Subject}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Row="1"
                                            FontSize="12"
                                            Foreground="{StaticResource RSApp.Styles.BaseGray040}"
                                            Text="{Binding Time, StringFormat='yyyy/MM/dd'}" />
                                    </Grid>-->
                                    <StackPanel Margin="10,5,10,5">
                                        <TextBlock
                                            FontSize="14"
                                            Text="{Binding Subject}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{StaticResource RSApp.Styles.BaseGray040}"
                                            Text="{Binding Time, StringFormat='yyyy/MM/dd'}" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="PART_Border" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="PART_Border" Property="Cursor" Value="Hand" />
                                        <Setter TargetName="PART_Border" Property="Background" Value="{StaticResource RSApp.Styles.BaseGray010}" />
                                    </Trigger>
                                    <Trigger SourceName="PART_Border" Property="IsMouseOver" Value="False">
                                        <Setter TargetName="PART_Border" Property="Background" Value="Transparent" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>


            </Border>
        </Popup>
    </Grid>
</UserControl>
