<UserControl
    x:Class="RS.WPFClient.Views.InBoxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:RS.WPFClient.Behaviors"
    xmlns:controls="clr-namespace:RS.WPFClient.Controls"
    xmlns:converter="clr-namespace:RS.WPFClient.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:RS.WPFClient.Enums"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:RS.WPFClient.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:RS.WPFClient.Models"
    xmlns:rs="https://github.com/luo-ross/MultiVerseKit"
    xmlns:viewModel="clr-namespace:RS.WPFClient.ViewModels"
    x:Name="this"
    d:DataContext="{d:DesignInstance Type=viewModel:InBoxViewModel}"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converter:MailDateGroupConverter x:Key="MailDateGroupConverter" />
        <converter:MailTimeFormatConverter x:Key="MailTimeFormatConverter" />

        <Style x:Key="MailDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="{StaticResource RSApp.Styles.BaseGray007}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border
                            x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path
                                    x:Name="PART_SelectIcon"
                                    Grid.Column="0"
                                    Width="10"
                                    Height="10"
                                    Margin="2,0,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="m9.5 6.393-5.691 4.471A.5.5 0 0 1 3 10.471V1.53a.5.5 0 0 1 .809-.393l5.69 4.47a.5.5 0 0 1 0 .787"
                                    Fill="{StaticResource RSApp.Styles.ChromeGreen}"
                                    Stretch="Uniform"
                                    Visibility="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <DataGridCellsPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding SelectionPosition}" Value="Top">
                                <Setter TargetName="PART_Border" Property="CornerRadius" Value="5,5,0,0" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectionPosition}" Value="Middle">
                                <Setter TargetName="PART_Border" Property="CornerRadius" Value="0" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectionPosition}" Value="Bottom">
                                <Setter TargetName="PART_Border" Property="CornerRadius" Value="0,0,5,5" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Setter Property="Focusable" Value="False" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsHeader}" Value="False">
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="Height" Value="40" />
                            </DataTrigger>

                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsHeader}" Value="False" />
                                    <Condition Binding="{Binding IsSelect}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="BorderBrush" Value="{StaticResource RSApp.Styles.ThemeAlpha020}" />
                                <Setter Property="Background" Value="{StaticResource RSApp.Styles.ThemeAlpha015}" />
                            </MultiDataTrigger>

                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsMouseOver}" Value="True" />
                                    <Condition Binding="{Binding IsSelect}" Value="false" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{StaticResource RSApp.Styles.BaseGray005}" />
                            </MultiDataTrigger>

                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsMouseOver}" Value="True" />
                                    <Condition Binding="{Binding IsHeader}" Value="False" />
                                    <Condition Binding="{Binding IsSelect}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{StaticResource RSApp.Styles.ThemeAlpha020}" />
                            </MultiDataTrigger>

                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.IsPreviewMode}" Value="True">
                                <Setter TargetName="PART_SelectIcon" Property="VerticalAlignment" Value="Top" />
                                <Setter TargetName="PART_SelectIcon" Property="Margin" Value="0,16,0,0" />
                                <Setter Property="Height" Value="auto" />
                            </DataTrigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="GroupHeaderTemplate" DataType="{x:Type model:GroupHeaderModel}">
            <Border>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        FontSize="13"
                        Foreground="{StaticResource RSApp.Styles.BaseGray080}"
                        Text="{Binding GroupTitle}" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Bottom"
                        FontSize="11"
                        Foreground="{StaticResource RSApp.Styles.BaseGray080}"
                        Text="{Binding ItemCount, StringFormat='({0}封)'}"
                        Visibility="{Binding ItemCount, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MailItemDataContentTemplate" DataType="{x:Type model:MailModel}">
            <Grid Height="40" TextBlock.FontSize="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="270" />
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="85" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    x:Name="PART_Selected"
                    Grid.Column="0"
                    Margin="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=DataContext.MailSelectCommand}"
                    IsChecked="{Binding IsSelect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />


                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="PART_OpenInNewWindow"
                        Grid.Column="0"
                        Margin="0"
                        Padding="0"
                        rs:ControlsHelper.IconHeight="16"
                        rs:ControlsHelper.IconWidth="16"
                        Style="{StaticResource RSApp.Styles.IconButtonStyle}"
                        ToolTip="新窗口打开" />

                    <controls:RSMailAccount
                        Grid.Column="1"
                        Account="{Binding Account}"
                        Email="{Binding Email}"
                        RecentInteractions="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=DataContext.MailList}" />
                </Grid>

                <Path
                    x:Name="PART_HasAttachment"
                    Grid.Column="2"
                    Width="14"
                    Height="14"
                    HorizontalAlignment="Left"
                    Data="M16.5 6v11.5c0 2.21-1.79 4-4 4s-4-1.79-4-4V5c0-1.38 1.12-2.5 2.5-2.5s2.5 1.12 2.5 2.5v10.5c0 .55-.45 1-1 1s-1-.45-1-1V6H10v9.5c0 1.66 1.34 3 3 3s3-1.34 3-3V5c0-2.48-2.02-4.5-4.5-4.5S7 2.52 7 5v12.5c0 3.59 2.91 6.5 6.5 6.5s6.5-2.91 6.5-6.5V6z"
                    Fill="Gray"
                    Stretch="Uniform"
                    Visibility="{Binding HasAttachment, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock
                    Grid.Column="3"
                    Margin="0,0,10,0"
                    HorizontalAlignment="Left"
                    FontSize="14"
                    TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Subject}" />
                    <Run Foreground="{StaticResource RSApp.Styles.BaseGray040}" Text="{Binding Digest}" />
                </TextBlock>

                <TextBlock
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Text="{Binding Time, Converter={StaticResource MailTimeFormatConverter}}" />

                <CheckBox
                    Grid.Column="5"
                    Margin="0"
                    Padding="3,5,3,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    rs:ControlsHelper.IconData="M11.537 8.231 10 4.177 8.463 8.23l-4.33.187 3.392 2.662-1.167 4.152L10 12.854l3.642 2.378-1.167-4.152 3.393-2.662zm6.518-.97c.43.019.605.554.269.818l-4.419 3.468 1.509 5.37c.115.409-.346.74-.704.505L10 14.347l-4.71 3.075c-.358.234-.819-.096-.704-.506l1.509-5.369L1.676 8.08a.458.458 0 0 1 .27-.818l5.64-.243 1.979-5.22a.467.467 0 0 1 .87 0l1.979 5.22z"
                    Command="{Binding DataContext.ToggleStarCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                    CommandParameter="{Binding}"
                    IsChecked="{Binding IsStarred, Mode=OneWay}"
                    ToolTip="添加星标">
                    <CheckBox.Style>
                        <Style BasedOn="{StaticResource RSApp.Styles.IconButtonStyle}" TargetType="CheckBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStarred}" Value="True">
                                    <Setter Property="Foreground" Value="#F4B400" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsStarred}" Value="False">
                                    <Setter Property="Foreground" Value="#BDC1C6" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource RSApp.Styles.BaseGray010}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRead}" Value="True">
                    <Setter TargetName="PART_OpenInNewWindow" Property="Foreground" Value="{StaticResource RSApp.Styles.BaseGray040}" />
                    <Setter TargetName="PART_OpenInNewWindow" Property="rs:ControlsHelper.IconData" Value="{StaticResource RSApp.Icons.EmailRead}" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsRead}" Value="False">
                    <Setter TargetName="PART_OpenInNewWindow" Property="Foreground" Value="#FBBC00" />
                    <Setter TargetName="PART_OpenInNewWindow" Property="rs:ControlsHelper.IconData" Value="{StaticResource RSApp.Icons.EmailUnread}" />
                </DataTrigger>

                <Trigger SourceName="PART_OpenInNewWindow" Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.7" />
                </Trigger>

            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="MailItemDataPreviewTemplate">
            <Grid Margin="0,10,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid>
                    <CheckBox
                        x:Name="PART_Selected"
                        Grid.Column="0"
                        Margin="0,2,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=DataContext.MailSelectCommand}"
                        IsChecked="{Binding IsSelect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="PART_OpenInNewWindow"
                                Grid.Column="0"
                                Margin="0"
                                Padding="0"
                                rs:ControlsHelper.IconHeight="16"
                                rs:ControlsHelper.IconWidth="16"
                                Style="{StaticResource RSApp.Styles.IconButtonStyle}"
                                ToolTip="新窗口打开" />

                            <controls:RSMailAccount
                                Grid.Column="1"
                                Account="{Binding Account}"
                                Email="{Binding Email}"
                                RecentInteractions="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=DataContext.MailList}" />

                            <Path
                                x:Name="PART_HasAttachment"
                                Grid.Column="3"
                                Width="14"
                                Height="14"
                                HorizontalAlignment="Left"
                                Data="M16.5 6v11.5c0 2.21-1.79 4-4 4s-4-1.79-4-4V5c0-1.38 1.12-2.5 2.5-2.5s2.5 1.12 2.5 2.5v10.5c0 .55-.45 1-1 1s-1-.45-1-1V6H10v9.5c0 1.66 1.34 3 3 3s3-1.34 3-3V5c0-2.48-2.02-4.5-4.5-4.5S7 2.52 7 5v12.5c0 3.59 2.91 6.5 6.5 6.5s6.5-2.91 6.5-6.5V6z"
                                Fill="Gray"
                                Stretch="Uniform"
                                Visibility="{Binding HasAttachment, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>


                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{Binding Time, Converter={StaticResource MailTimeFormatConverter}}" />

                    </Grid>

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Left"
                        FontSize="14"
                        TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Subject}" />
                    </TextBlock>

                    <TextBlock
                        Grid.Row="2"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Left"
                        FontSize="14"
                        TextTrimming="CharacterEllipsis">
                        <Run Foreground="{StaticResource RSApp.Styles.BaseGray040}" Text="{Binding Digest}" />
                    </TextBlock>
                </Grid>
            </Grid>


            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRead}" Value="True">
                    <Setter TargetName="PART_OpenInNewWindow" Property="Foreground" Value="{StaticResource RSApp.Styles.BaseGray040}" />
                    <Setter TargetName="PART_OpenInNewWindow" Property="rs:ControlsHelper.IconData" Value="{StaticResource RSApp.Icons.EmailRead}" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsRead}" Value="False">
                    <Setter TargetName="PART_OpenInNewWindow" Property="Foreground" Value="#FBBC00" />
                    <Setter TargetName="PART_OpenInNewWindow" Property="rs:ControlsHelper.IconData" Value="{StaticResource RSApp.Icons.EmailUnread}" />
                </DataTrigger>

                <Trigger SourceName="PART_OpenInNewWindow" Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.7" />
                </Trigger>

            </DataTemplate.Triggers>
        </DataTemplate>




    </UserControl.Resources>


    <Border
        x:Name="Test111"
        Grid.Column="0"
        CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PART_Left">
                    <ColumnDefinition.Style>
                        <Style TargetType="{x:Type ColumnDefinition}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPreviewMode}" Value="True">
                                    <Setter Property="Width" Value="61.8*" />
                                    <Setter Property="MinWidth" Value="350" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPreviewMode}" Value="False">
                                    <Setter Property="Width" Value="*" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition x:Name="PART_Right">
                    <ColumnDefinition.Style>
                        <Style TargetType="{x:Type ColumnDefinition}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPreviewMode}" Value="True">
                                    <Setter Property="Width" Value="38.2*" />
                                    <Setter Property="MinWidth" Value="470" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPreviewMode}" Value="False">
                                    <Setter Property="Width" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Border
                Grid.Row="0"
                Grid.Column="0"
                Padding="15,0,0,0"
                BorderBrush="{StaticResource RSApp.Styles.BaseGray007}"
                BorderThickness="0,0,1,0">
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
                    <Grid Width="30">
                        <CheckBox
                            x:Name="PART_SelectAll"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Command="{Binding MailSelectAllCommand}"
                            IsChecked="{Binding IsSelectedAll}">
                            <CheckBox.Style>
                                <Style BasedOn="{StaticResource RSApp.Styles.CheckBoxStyle}" TargetType="{x:Type CheckBox}">
                                    <Setter Property="IsThreeState" Value="True" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="IsThreeState" Value="False" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                    </Grid>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="收件箱" />
                    <controls:RSMailFilter Margin="5,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPreviewMode}" Value="True">
                                <Setter Property="Margin" Value="20,0,100,0" />
                                <Setter Property="Grid.Column" Value="10" />
                                <Setter Property="HorizontalAlignment" Value="Left" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPreviewMode}" Value="False">
                                <Setter Property="Margin" Value="330,0,40,0" />
                                <Setter Property="Grid.Column" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>


                <Button
                    rs:ControlsHelper.IconData="{StaticResource RSApp.Icons.Delete}"
                    BorderBrush="#eee"
                    BorderThickness="1"
                    Command="{Binding DeleteCommand}"
                    Content="删除"
                    Style="{StaticResource RSApp.Styles.IconWithDesButton}" />
                <Button
                    rs:ControlsHelper.IconData="M7.75 11.75v2.495L2.898 9.999 7.75 5.754v2.495H9.5c1.624 0 3.706.836 5.397 2.414a9.2 9.2 0 0 1 2.01 2.692c-.99-.513-2.042-.848-2.996-1.073-2.266-.533-4.381-.533-4.906-.533zm9.817 3.509A5.2 5.2 0 0 1 19 16.999a9.5 9.5 0 0 0-.312-2.427C17.47 9.945 12.933 7 9.5 7H9V4.101a.5.5 0 0 0-.83-.376L1.43 9.623a.5.5 0 0 0 0 .753l6.74 5.898a.5.5 0 0 0 .83-.377V13c.202 0 .649 0 1.25.033 1.859.102 5.191.52 7.317 2.227"
                    BorderBrush="#eee"
                    BorderThickness="1"
                    Command="{Binding ReplyCommand}"
                    Content="回复"
                    Style="{StaticResource RSApp.Styles.IconWithDesButton}" />

                <Button
                    rs:ControlsHelper.IconData="M8.013 4.568a.625.625 0 0 0-.826-.938L.913 9.155a1.125 1.125 0 0 0 0 1.688l6.274 5.525a.625.625 0 0 0 .826-.938L1.846 10zM9.85 13v-1.25h1.25c.69 0 2.466.293 4.247.953.613.227 1.275.515 1.92.878a9.6 9.6 0 0 0-1.74-3.017c-1.362-1.588-2.92-2.314-3.927-2.314H9.85V5.754L4.998 9.999l4.852 4.245zm9.25 4c-.311-.623-.795-1.16-1.375-1.619-1.59-1.259-3.903-1.937-5.375-2.22-.578-.11-1.026-.16-1.25-.16v2.897a.5.5 0 0 1-.83.376l-6.74-5.898a.5.5 0 0 1 0-.752l6.74-5.898a.5.5 0 0 1 .83.376v2.898h.5c2.601 0 6.33 3.007 7.276 7.718.145.722.224 1.484.224 2.282"
                    BorderBrush="#eee"
                    BorderThickness="1"
                    Command="{Binding ReplyAllCommand}"
                    Content="回复全部"
                    Style="{StaticResource RSApp.Styles.IconWithDesButton}" />
                <Button
                    rs:ControlsHelper.IconData="M12.25 12.75v1.894l4.852-4.245-4.852-4.245V8.25h-9v4.5zM3 14a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1h8V4.501a.5.5 0 0 1 .83-.376l6.74 5.898a.5.5 0 0 1 0 .752l-6.74 5.899a.5.5 0 0 1-.83-.377V14z"
                    BorderBrush="#eee"
                    BorderThickness="1"
                    Command="{Binding ForwardCommand}"
                    Content="转发"
                    Style="{StaticResource RSApp.Styles.IconWithDesButton}" />

                <Button
                    rs:ControlsHelper.IconData="M9.794 2.819 4.25 4.403V9.18c0 3.63 2.33 6.836 5.75 7.972a8.4 8.4 0 0 0 5.75-7.972V4.403l-5.544-1.584a.75.75 0 0 0-.412 0M3 9.179a9.65 9.65 0 0 0 7 9.281 9.65 9.65 0 0 0 7-9.28V4.214a1 1 0 0 0-.725-.961l-5.726-1.636a2 2 0 0 0-1.098 0L3.725 3.253A1 1 0 0 0 3 4.214zm6.062-2.683.23 3.811a.72.72 0 0 0 .708.691.72.72 0 0 0 .708-.69l.23-3.812c.033-.561-.396-1.036-.938-1.036s-.971.475-.938 1.036M11 13.421c0 .574-.448 1.039-1 1.039s-1-.465-1-1.039.448-1.038 1-1.038 1 .465 1 1.038"
                    BorderBrush="#eee"
                    BorderThickness="1"
                    Command="{Binding ReportCommand}"
                    Content="举报"
                    Style="{StaticResource RSApp.Styles.IconWithDesButton}" />

                <Button
                    rs:ControlsHelper.IconData="M9.5 4.377 14.102 6.5 9.5 8.8l-4.601-2.3zM4.25 13.75V7.574l4.747 2.373c.317.159.69.159 1.006 0l4.747-2.373v6.176zm-.67-8.018A1 1 0 0 0 3 6.64V14a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1V6.64a1 1 0 0 0-.58-.908L9.71 3.097a.5.5 0 0 0-.42 0zM6.5 17a1.5 1.5 0 0 1-1.48-1.25h11.73V8.02A1.5 1.5 0 0 1 18 9.5V16a1 1 0 0 1-1 1z"
                    BorderBrush="#eee"
                    BorderThickness="1"
                    Command="{Binding MarkAllAsReadCommand}"
                    Content="全部已读"
                    Style="{StaticResource RSApp.Styles.IconWithDesButton}" />


                <rs:RSDropdown
                    rs:ControlsHelper.IconData="M11.537 8.231 10 4.177 8.463 8.23l-4.33.187 3.392 2.662-1.167 4.152L10 12.854l3.642 2.378-1.167-4.152 3.393-2.662zm6.518-.97c.43.019.605.554.269.818l-4.419 3.468 1.509 5.37c.115.409-.346.74-.704.505L10 14.347l-4.71 3.075c-.358.234-.819-.096-.704-.506l1.509-5.369L1.676 8.08a.458.458 0 0 1 .27-.818l5.64-.243 1.979-5.22a.467.467 0 0 1 .87 0l1.979 5.22z"
                    BorderBrush="#eee"
                    BorderThickness="1"
                    Content="标记为"
                    DropdownWidth="200"
                    IsShowDropDownIcon="True">
                    <rs:RSDropdown.DropdownContent>
