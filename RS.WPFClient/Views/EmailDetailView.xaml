0889-133.575111 34.360889z m287.266133-7.259023c-17.885867 6.644622-74.729244-13.744356-74.729244-13.744355l7.5776-0.910222c52.929422-6.599111 69.563733 2.844444 73.773511 6.189511 0.500622 3.754667-4.096 7.532089-6.621867 8.465066z"
                                rs:ControlsHelper.IconHeight="18"
                                rs:ControlsHelper.IconWidth="18"
                                FontSize="13">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource RSApp.Styles.IconWithDesButton}" TargetType="{x:Type Button}">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Margin" Value="5,0,0,0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Foreground" Value="{StaticResource RSApp.Styles.AccentBlueDarken1}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Foreground" Value="{StaticResource RSApp.Styles.AccentBlueLighten1}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
