                    rs:ControlsHelper.IconWidth="10"
                    BorderThickness="0"
                    Style="{StaticResource RSApp.Styles.IconButtonStyle}" />
            </Grid>
        </Border>

        <Border Grid.Row="3">
            <web:WebView2
                x:Name="webView"
                rs:WebView2Helper.HtmlContent="{Binding SelectedMail.Content}"
                rs:WebView2Helper.OpenExternalLinks="True" />
        </Border>
    </Grid>
</UserControl>
