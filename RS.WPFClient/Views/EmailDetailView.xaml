                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DataTemplate>


        <DataTemplate x:Key="BasicTimeWrapTemplate" DataType="{x:Type model:EmailModel}">
            <StackPanel Orientation="Horizontal">
                <rs:RSSelectableTextBlock
                    FontSize="13"
                    Foreground="{StaticResource RSApp.Styles.BaseGray050}"
                    Text="{Binding Time, StringFormat='{}{0:yyyy年MM月dd日 HH:mm}'}">
                    <rs:RSSelectableTextBlock.Style>
                        <Style BasedOn="{StaticResource RSApp.Styles.TextBlockStyle}" TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:EmailDetailView}}, Path=DataContext.IsBasicDetail}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </rs:RSSelectableTextBlock.Style>
                </rs:RSSelectableTextBlock>
                <ToggleButton
                    VerticalContentAlignment="Center"
                    rs:ControlsHelper.HasDecoration="True"
                    IsChecked="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:EmailDetailView}}, Path=DataContext.IsBasicDetail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ToggleButton.Style>
                        <Style BasedOn="{StaticResource RSApp.Styles.ButtonBaseStyle}" TargetType="{x:Type ToggleButton}">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Margin" Value="5,0,0,0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Foreground" Value="{StaticResource RSApp.Styles.AccentBlueDarken1}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{StaticResource RSApp.Styles.AccentBlueLighten1}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource RSApp.Styles.AccentBlueLighten2}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:EmailDetailView}}, Path=DataContext.IsBasicDetail}" Value="True">
                                    <Setter Property="Content" Value="详细信息" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:EmailDetailView}}, Path=DataContext.IsBasicDetail}" Value="False">
                                    <Setter Property="Content" Value="隐藏信息" />
                                    <Setter Property="Margin" Value="100,0,0,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
            </StackPanel>
        </DataTemplate>



        <DataTemplate x:Key="EmailProxyTemplate" DataType="{x:Type model:EmailModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <rs:RSSelectableTextBlock
                        FontSize="13"
                        Foreground="{StaticResource RSApp.Styles.BaseGray040}"
                        Text="由" />

                    <Grid x:Name="ProxyHost" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>


                        <rs:RSSelectableTextBlock
                            x:Name="ProxyName"
                            Grid.Column="0"
                            Margin="2,0,0,0"
                            Padding="0"
                            FontSize="13"
                            Foreground="{StaticResource RSApp.Styles.BaseGray040}"
                            Text="{Binding ProxyName, Converter={StaticResource EmailParserConverter}, ConverterParameter=Name}"
                            TextTrimming="CharacterEllipsis" />

                        <rs:RSSelectableTextBlock
                            Grid.Column="1"
                            Margin="0"
                            Padding="0"
                            FontSize="13"
                            Foreground="{StaticResource RSApp.Styles.BaseGray040}"
                            Text="@" />


                        <rs:RSSelectableTextBlock
                            Grid.Column="2"
                            Margin="0"
                            Padding="0"
                            FontSize="13"
                            Foreground="{StaticResource RSApp.Styles.BaseGray040}"
                            Text="{Binding ProxyName, Converter={StaticResource EmailParserConverter}, ConverterParameter=Domain}"
                            TextTrimming="CharacterEllipsis" />

                    </Grid>

                    <rs:RSSelectableTextBlock
                        Grid.Column="4"
                        Margin="2,0,0,0"
                        Padding="0"
                        FontSize="12"
                        Foreground="{StaticResource RSApp.Styles.BaseGray040}"
                        Text="代发" />
                </Grid>
                <ContentControl
                    Grid.Column="1"
                    Margin="20,0,0,0"
                    HorizontalAlignment="Right"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource BasicTimeWrapTemplate}" />
            </Grid>


        </DataTemplate>


        <DataTemplate x:Key="EmailToTemplate" DataType="{x:Type model:EmailModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="45" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <rs:RSSelectableTextBlock
                    FontSize="13"
                    Foreground="{StaticResource RSApp.Styles.BaseGray040}"
                    Text="收件人" />
                <rs:RSSelectableTextBlock
                    Grid.Column="1"
                    Margin="2,0,0,0"
                    FontSize="13"
                    Foreground="{StaticResource RSApp.Styles.BaseGray100}">
                    <rs:RSSelectableTextBlock.Style>
                        <Style BasedOn="{StaticResource RSApp.Styles.TextBlockStyle}" TargetType="{x:Type TextBlock}">
                            <Setter Property="Text" Value="我" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:EmailDetailView}}, Path=DataContext.IsBasicDetail}" Value="False">
                                    <Setter Property="Text" Value="行云游者" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </rs:RSSelectableTextBlock.Style>
                </rs:RSSelectableTextBlock>


                <StackPanel
                    Grid.Column="2"
                    Margin="2,0,0,0"
                    Orientation="Horizontal">
                    <rs:RSSelectableTextBlock
                        Margin="0"
                        Padding="0"
                        FontSize="13"
                        Foreground="{StaticResource RSApp.Styles.BaseGray040}"
                        Text="&lt;" />
                    <rs:RSSelectableTextBlock
                        Margin="0"
                        Padding="0"
                        FontSize="13"
                        Foreground="{StaticResource RSApp.Styles.BaseGray040}"
                        Text="1845960295@qq.com" />
                    <rs:RSSelectableTextBlock
                        Margin="0"
                        Padding="0"
                        FontSize="13"
                        Foreground="{StaticResource RSApp.Styles.BaseGray040}"
                        Text="&gt;" />
                </StackPanel>

                <ContentControl
                    Grid.Column="3"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource BasicTimeWrapTemplate}">
                    <ContentControl.Style>
                        <Style TargetType="{x:Type ContentControl}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProxyName}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>
        </DataTemplate>


        <DataTemplate x:Key="EmailFromTemplate" DataType="{x:Type model:EmailModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="45" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <rs:RSSelectableTextBlock
                    FontSize="13"
                    Foreground="{StaticResource RSApp.Styles.BaseGray040}"
                    Text="发件人" />

                <rs:RSSelectableTextBlock
                    Grid.Column="1"
                    Margin="2,0,0,0"
                    FontSize="13"
                    Foreground="{StaticResource RSApp.Styles.BaseGray100}"
                    Text="Team" />

                <StackPanel
                    Grid.Column="2"
                    Margin="2,0,0,0"
                    Orientation="Horizontal">
                    <rs:RSSelectableTextBlock
                        Margin="0"
                        Padding="0"
                        FontSize="13"
                        Foreground="{StaticResource RSApp.Styles.BaseGray040}"
                        Text="&lt;" />
                    <rs:RSSelectableTextBlock
                        Margin="0"
                        Padding="0"
                        FontSize="13"
                        Foreground="{StaticResource RSApp.Styles.BaseGray040}"
                        Text="team@avaloniaui.net" />
                    <rs:RSSelectableTextBlock
                        Margin="0"
                        Padding="0"
                        FontSize="13"
                        Foreground="{StaticResource RSApp.Styles.BaseGray040}"
                        Text="&gt;" />
                </StackPanel>
            </Grid>
        </DataTemplate>


        <DataTemplate x:Key="EmailSizeTemplate" DataType="{x:Type model:EmailModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="45" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <rs:RSSelectableTextBlock
                    FontSize="13"
                    Foreground="{StaticResource RSApp.Styles.BaseGray040}"
                    Text="大小" />

                <rs:RSSelectableTextBlock
                    Grid.Column="1"
                    Margin="2,0,0,0"
                    FontSize="13"
                    Foreground="{StaticResource RSApp.Styles.BaseGray100}"
                    Text="5K" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="EmailTimeTemplate" DataType="{x:Type model:EmailModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="45" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <rs:RSSelectableTextBlock
                    FontSize="13"
                    Foreground="{StaticResource RSApp.Styles.BaseGray040}"
                    Text="时间" />

                <rs:RSSelectableTextBlock
                    Grid.Column="1"
                    Margin="2,0,0,0"
                    FontSize="13"
                    Foreground="{StaticResource RSApp.Styles.BaseGray100}"
                    Text="{Binding Time, StringFormat='{}{0:yyyy年MM月dd日 HH:mm}'}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="EmailBasicDetailTemplate" DataType="{x:Type model:EmailModel}">
            <StackPanel Margin="10,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <rs:RSSelectableTextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="{StaticResource RSApp.Styles.BaseGray100}"
                        Text="{Binding Account}" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="2,0,0,0"
                        Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:EmailDetailView}}, Path=DataContext.IsBasicDetail}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <rs:RSSelectableTextBlock
                            Margin="0"
                            Padding="0"
                            FontSize="13"
                            Foreground="{StaticResource RSApp.Styles.BaseGray040}"
                            Text="&lt;" />
                        <rs:RSSelectableTextBlock
                            Margin="0"
                            Padding="0"
                            FontSize="13"
                            Foreground="{StaticResource RSApp.Styles.BaseGray040}"
                            Text="noreply@github.com" />
                        <rs:RSSelectableTextBlock
                            Margin="0"
                            Padding="0"
                            FontSize="13"
                            Foreground="{StaticResource RSApp.Styles.BaseGray040}"
                            Text="&gt;" />
                    </StackPanel>
                    <ContentControl
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource EmailDetailActionBarTemplate}" />
                </Grid>
                <ContentControl
                    Margin="0,2,0,2"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource EmailProxyTemplate}" />
                <ContentControl
                    Margin="0,2,0,2"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource EmailFromTemplate}">
                    <ContentControl.Style>
                        <Style TargetType="{x:Type ContentControl}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:EmailDetailView}}, Path=DataContext.IsBasicDetail}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:EmailDetailView}}, Path=DataContext.IsBasicDetail}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <ContentControl
                    Margin="0,2,0,2"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource EmailToTemplate}" />
                <ContentControl
                    Margin="0,2,0,2"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource EmailSizeTemplate}">
                    <ContentControl.Style>
                        <Style TargetType="{x:Type ContentControl}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:EmailDetailView}}, Path=DataContext.IsBasicDetail}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:EmailDetailView}}, Path=DataContext.IsBasicDetail}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <ContentControl
                    Margin="0,2,0,2"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource EmailTimeTemplate}">
                    <ContentControl.Style>
                        <Style TargetType="{x:Type ContentControl}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:EmailDetailView}}, Path=DataContext.IsBasicDetail}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:EmailDetailView}}, Path=DataContext.IsBasicDetail}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <ContentControl
                    Margin="0,2,0,2"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource EmailAttachmentTemplate}" />
            </StackPanel>
        </DataTemplate>

    </UserControl.Resources>
    <Grid Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <TextBlock TextWrapping="WrapWithOverflow">
                <Run
                    FontSize="20"
                    FontWeight="Bold"
                    Text="{Binding SelectedMail.Subject}" />
                <InlineUIContainer BaselineAlignment="Center">
                    <CheckBox
                        Margin="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        rs:ControlsHelper.IconHeight="16"
                        rs:ControlsHelper.IconWidth="16"
                        Command="{Binding DataContext.ToggleStarCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                        CommandParameter="{Binding SelectedMail}"
                        IsChecked="{Binding SelectedMail.IsStarred, Mode=OneWay}">
                        <CheckBox.Style>
                            <Style BasedOn="{StaticResource RSApp.Styles.IconButtonStyle}" TargetType="CheckBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMail.IsStarred}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource RSApp.Styles.ChromeYellowLighten1}" />
                                        <Setter Property="rs:ControlsHelper.IconData" Value="{StaticResource RSApp.Icons.Email.StarFilled}" />
                                        <Setter Property="ToolTip" Value="取消星标" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedMail.IsStarred}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource RSApp.Styles.BaseGray050}" />
                                        <Setter Property="rs:ControlsHelper.IconData" Value="{StaticResource RSApp.Icons.Email.StarOutline}" />
                                        <Setter Property="ToolTip" Value="添加星标" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource RSApp.Styles.BaseGray010}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                </InlineUIContainer>
            </TextBlock>
        </Grid>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Grid.Column="0"
                Width="36"
                Height="36"
                Margin="0,2,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{StaticResource RSApp.Styles.BaseGray010}"
                CornerRadius="25">
                <Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="24"
                        Foreground="White"
                        Text="{Binding SelectedMail.Account, Converter={StaticResource FirstCharConverter}}" />
                    <Image Source="{Binding SelectedMail.Avatar}" Stretch="UniformToFill">
                        <Image.Clip>
                            <EllipseGeometry
                                Center="25,25"
                                RadiusX="25"
                                RadiusY="25" />
                        </Image.Clip>
                    </Image>
                </Grid>
            </Border>


            <ContentControl
                Grid.Column="1"
                Margin="5,0,0,0"
                Content="{Binding SelectedMail}"
                ContentTemplate="{StaticResource EmailBasicDetailTemplate}" />
        </Grid>


        <Border
            Grid.Row="2"
            Margin="0,20,0,0"
            Padding="12,6,8,6"
            Background="{StaticResource RSApp.Styles.BgGrayWeb1}"
