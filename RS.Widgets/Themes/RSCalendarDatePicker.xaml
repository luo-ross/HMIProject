<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:models="clr-namespace:RS.Widgets.Models"
    xmlns:rs="clr-namespace:RS.Widgets.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/RS.Widgets;component/Styles/Controls.Button.xaml" />
        <ResourceDictionary Source="pack://application:,,,/RS.Widgets;component/Styles/Controls.Effects.xaml" />
        <ResourceDictionary Source="pack://application:,,,/RS.Widgets;component/Styles/Controls.Icons.xaml" />
        <ResourceDictionary Source="pack://application:,,,/RS.Widgets;component/Styles/Controls.TextBlock.xaml" />
        <ResourceDictionary Source="pack://application:,,,/RS.Widgets;component/Styles/Controls.TextBox.xaml" />
    </ResourceDictionary.MergedDictionaries>


    <DataTemplate DataType="{x:Type models:CalendarDayModel}">
        <Grid x:Name="PART_Grid" Background="Transparent">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                    <i:InvokeCommandAction Command="{Binding CalendarItemClickCommand}" CommandParameter="{Binding}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <Ellipse x:Name="PART_Ellipse" Margin="3" />
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                    x:Name="PART_MonthName"
                    Margin="0,-9,0,0"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    FontSize="9"
                    Text="{Binding MonthName}"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="PART_Day"
                    Margin="0"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Text="{Binding DisplayContent}" />
            </Grid>

        </Grid>
        <DataTemplate.Triggers>
            <Trigger SourceName="PART_Grid" Property="IsMouseOver" Value="True">
                <Setter TargetName="PART_Ellipse" Property="Fill" Value="#F6F6F6" />
            </Trigger>
            <DataTrigger Binding="{Binding IsToday}" Value="True">
                <Setter TargetName="PART_Ellipse" Property="Fill" Value="#0067C6" />
            </DataTrigger>

            <DataTrigger Binding="{Binding IsBlackout}" Value="True">
                <Setter TargetName="PART_Day" Property="Foreground" Value="#949494" />
                <Setter TargetName="PART_MonthName" Property="Foreground" Value="#949494" />
            </DataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsToday}" Value="True" />
                    <Condition Binding="{Binding ElementName=PART_Grid, Path=IsMouseOver}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="PART_Ellipse" Property="Fill" Value="#1A76C6" />
            </MultiDataTrigger>

            <DataTrigger Binding="{Binding IsToday}" Value="True">
                <Setter TargetName="PART_Day" Property="Foreground" Value="#FFFFFF" />
                <Setter TargetName="PART_MonthName" Property="Foreground" Value="#FFFFFF" />
            </DataTrigger>

            <DataTrigger Binding="{Binding IsFirstDayOfMonth}" Value="True">
                <Setter TargetName="PART_MonthName" Property="Visibility" Value="Visible" />
            </DataTrigger>

            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="PART_Ellipse" Property="Stroke" Value="#1A76C6" />
                <Setter TargetName="PART_Ellipse" Property="StrokeThickness" Value="1" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="False">
                <Setter TargetName="PART_Ellipse" Property="Stroke" Value="Transparent" />
                <Setter TargetName="PART_Ellipse" Property="StrokeThickness" Value="1" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>


