    <Style TargetType="{x:Type rs:RSCalendarDatePicker}">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#E5E5E5" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type rs:RSCalendarDatePicker}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border
                                x:Name="PART_TitleHost"
                                Padding="5"
                                BorderBrush="#EEEEEE"
                                BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="PART_BtnTitle" HorizontalContentAlignment="Left">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource RSApp.Styles.ButtonBaseStyle}" TargetType="{x:Type ButtonBase}">
                                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                <Setter Property="VerticalAlignment" Value="Stretch" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#fff" />
                                                        <Setter Property="Foreground" Value="#949494" />
                                                    </Trigger>
                                                    <!--<Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Setter Property="Background" Value="#EEE" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background" Value="#F1F1F1" />
                                                    </Trigger>-->
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button
                                            x:Name="PART_PageUp"
                                            Padding="8"
                                            rs:ControlsHelper.IconData="{StaticResource RSApp.Icons.MenuItemUpArrow}"
                                            rs:ControlsHelper.IconHeight="8"
                                            rs:ControlsHelper.IconWidth="8"
                                            Style="{StaticResource RSApp.Styles.IconButtonStyle}" />
                                        <Button
                                            x:Name="PART_PageDown"
                                            Padding="8"
                                            rs:ControlsHelper.IconData="{StaticResource RSApp.Icons.MenuItemDownArrow}"
                                            rs:ControlsHelper.IconHeight="8"
                                            rs:ControlsHelper.IconWidth="8"
                                            Style="{StaticResource RSApp.Styles.IconButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid
                                x:Name="PART_DayOfWeekHost"
                                Grid.Row="1"
                                Visibility="Collapsed">
                                <ItemsControl x:Name="PART_DayOfWeek" ItemsSource="{TemplateBinding WeekdayList}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid
                                                Height="{Binding RelativeSource={RelativeSource AncestorType={x:Type rs:RSCalendarDatePicker}}, Path=DayOfWeekHeight}"
                                                Columns="7"
                                                Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border>
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <ScrollViewer
                                x:Name="PART_ScrollViewer"
                                Grid.Row="2"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden">
                                <Canvas
                                    x:Name="PART_Canvas"
                                    Background="Transparent"
                                    ClipToBounds="True" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="CalendarViewType" Value="Day">
                            <Setter TargetName="PART_DayOfWeekHost" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="CalendarViewType" Value="Year">
                            <Setter TargetName="PART_BtnTitle" Property="IsEnabled" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>