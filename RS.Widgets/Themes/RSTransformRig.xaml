<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:RS.Widgets.Converters"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:rs="clr-namespace:RS.Widgets.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/RS.Widgets;component/Styles/Controls.Button.xaml" />
        <ResourceDictionary Source="pack://application:,,,/RS.Widgets;component/Styles/Controls.Effects.xaml" />
        <ResourceDictionary Source="pack://application:,,,/RS.Widgets;component/Styles/Controls.Icons.xaml" />
        <ResourceDictionary Source="pack://application:,,,/RS.Widgets;component/Styles/Controls.Templates.xaml" />
        <ResourceDictionary Source="pack://application:,,,/RS.Widgets;component/Styles/Controls.TextBlock.xaml" />
        <ResourceDictionary Source="pack://application:,,,/RS.Widgets;component/Styles/Controls.TextBox.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <converters:MathDivideConverter x:Key="MathDivideConverter" />
    <converters:ForegroundColorConverter x:Key="ForegroundColorConverter" />
    <converters:DarkerContrastBrushConverter
        x:Key="DarkerContrastBrushConverter"
        DarkenLevel="0.5"
        MinBrightness="0.15" />
    <Style x:Key="RSApp.Styles.TransformThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <Style x:Key="RSApp.Styles.RectDirectionArrowThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="#333333" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border>
                        <Grid>
                            <Path
                                VerticalAlignment="Top"
                                Data="{StaticResource RSApp.Icons.UpArrow}"
                                Fill="{TemplateBinding Foreground}"
                                Stretch="Uniform" />
                            <Border
                                Width="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RSApp.Styles.RectDirectionThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="#333333" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Rectangle Fill="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style
        x:Key="RSApp.Styles.DirectionButtonStyle"
        BasedOn="{StaticResource RSApp.Styles.IconButtonStyle}"
        TargetType="{x:Type Button}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="rs:ControlsHelper.IconStroke" Value="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Foreground, Converter={StaticResource DarkerContrastBrushConverter}}" />
                <Setter Property="rs:ControlsHelper.IconStrokeThickness" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type rs:RSTransformRig}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type rs:RSTransformRig}">
                    <Grid
                        x:Name="PART_Root"
                        Background="{TemplateBinding Background}"
                        RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform Angle="{Binding RotationAngle, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Grid.RenderTransform>
                        <Thumb
                            x:Name="PART_MoveThumb"
                            Background="Transparent"
                            Cursor="SizeAll">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="{TemplateBinding Background}" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>


                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="FirstRow" />
                                <RowDefinition x:Name="SecondRow" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="FirstCol" />
                                <ColumnDefinition x:Name="SecondCol" />
                            </Grid.ColumnDefinitions>
                            <Thumb
                                x:Name="PART_RectDirectionArrow"
                                Width="20"
                                MinHeight="32"
                                Foreground="{TemplateBinding BorderBrush}"
                                Style="{StaticResource RSApp.Styles.RectDirectionArrowThumbStyle}" />
                        </Grid>

                        <Grid
                            x:Name="PART_RectDirectionHost"
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Width="45"
                            Height="45">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="PART_RectDirectionTop"
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                rs:ControlsHelper.IconData="{StaticResource RSApp.Icons.TriangleUp}"
                                Background="Transparent"
                                Foreground="{TemplateBinding BorderBrush}"
                                Style="{StaticResource RSApp.Styles.DirectionButtonStyle}" />
                            <Button
                                x:Name="PART_RectDirectionLeft"
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0"
                                Padding="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                rs:ControlsHelper.IconData="{StaticResource RSApp.Icons.TriangleLeft}"
                                Background="Transparent"
                                Foreground="{TemplateBinding BorderBrush}"
                                Style="{StaticResource RSApp.Styles.DirectionButtonStyle}" />
                            <Button
                                x:Name="PART_RectDirectionRight"
                                Grid.Row="1"
                                Grid.Column="2"
                                Margin="0"
                                Padding="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                rs:ControlsHelper.IconData="{StaticResource RSApp.Icons.TriangleRight}"
                                Background="Transparent"
                                Foreground="{TemplateBinding BorderBrush}"
                                Style="{StaticResource RSApp.Styles.DirectionButtonStyle}" />
                            <Button
                                x:Name="PART_RectDirectionBottom"
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="0"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                rs:ControlsHelper.IconData="{StaticResource RSApp.Icons.TriangleDown}"
                                Background="Transparent"
                                Foreground="{TemplateBinding BorderBrush}"
                                Style="{StaticResource RSApp.Styles.DirectionButtonStyle}" />
                        </Grid>

                        <Border
                            x:Name="PART_Frame"
                            Margin="-1"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            IsHitTestVisible="False" />

                        <Thumb
                            x:Name="PART_Top"
                            Height="5"
                            Margin="3,-3,3,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            Style="{StaticResource RSApp.Styles.TransformThumbStyle}" />

                        <Thumb
                            x:Name="PART_Bottom"
                            Height="5"
                            Margin="3,0,3,-3"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            Background="Transparent"
                            Style="{StaticResource RSApp.Styles.TransformThumbStyle}" />

                        <Thumb
                            x:Name="PART_Left"
                            Width="5"
                            Margin="-3,3,0,3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            Background="Transparent"
                            Style="{StaticResource RSApp.Styles.TransformThumbStyle}" />

                        <Thumb
                            x:Name="PART_Right"
                            Width="5"
                            Margin="0,3,-3,3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Background="Transparent"
                            Style="{StaticResource RSApp.Styles.TransformThumbStyle}" />

                        <Thumb
                            x:Name="PART_TopLeftRotate"
                            Width="10"
                            Height="10"
                            Margin="-7,-7,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            Style="{StaticResource RSApp.Styles.TransformThumbStyle}" />


                        <Thumb
                            x:Name="PART_TopLeft"
                            Width="7"
                            Height="7"
                            Margin="-4,-4,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            Style="{StaticResource RSApp.Styles.TransformThumbStyle}" />


                        <Thumb
                            x:Name="PART_TopRightRotate"
                            Width="10"
                            Height="10"
                            Margin="0,-7,-7,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            Style="{StaticResource RSApp.Styles.TransformThumbStyle}" />

                        <Thumb
                            x:Name="PART_TopRight"
                            Width="7"
                            Height="7"
                            Margin="0,-4,-4,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            Style="{StaticResource RSApp.Styles.TransformThumbStyle}" />



                        <Thumb
                            x:Name="PART_BottomLeftRotate"
                            Width="10"
                            Height="10"
                            Margin="-7,0,0,-7"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Background="Transparent"
                            Style="{StaticResource RSApp.Styles.TransformThumbStyle}" />


                        <Thumb
                            x:Name="PART_BottomLeft"
                            Width="7"
                            Height="7"
                            Margin="-4,0,0,-4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Background="Transparent"
                            Style="{StaticResource RSApp.Styles.TransformThumbStyle}" />

                        <Thumb
                            x:Name="PART_BottomRightRotate"
                            Width="10"
                            Height="10"
                            Margin="0,0,-7,-7"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="Transparent"
                            Style="{StaticResource RSApp.Styles.TransformThumbStyle}" />


                        <Thumb
                            x:Name="PART_BottomRight"
                            Width="7"
                            Height="7"
                            Margin="0,0,-4,-4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="Transparent"
                            Style="{StaticResource RSApp.Styles.TransformThumbStyle}" />


                        <Grid
                            x:Name="PART_DirectionPreviewHost"
                            Width="20"
                            Height="32"
                            Visibility="Collapsed">
                            <Path
                                VerticalAlignment="Top"
                                Data="{StaticResource RSApp.Icons.UpArrow}"
                                Fill="{TemplateBinding BorderBrush,
                                                       Converter={StaticResource DarkerContrastBrushConverter}}"
                                Stretch="Uniform" />
                            <Border
                                Width="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                Background="{TemplateBinding BorderBrush,
                                                             Converter={StaticResource DarkerContrastBrushConverter}}" />
                        </Grid>

                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="RectDirection" Value="Top">
                            <Setter TargetName="FirstRow" Property="Height" Value="2*" />
                            <Setter TargetName="SecondRow" Property="Height" Value="8*" />
                            <Setter TargetName="PART_RectDirectionArrow" Property="Grid.Row" Value="0" />
                            <Setter TargetName="PART_RectDirectionArrow" Property="Grid.Column" Value="0" />
                            <Setter TargetName="PART_RectDirectionArrow" Property="Grid.ColumnSpan" Value="2" />
                            <Setter TargetName="PART_RectDirectionArrow" Property="Margin" Value="0,-20,0,0" />
                            <Setter TargetName="PART_RectDirectionArrow" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="PART_RectDirectionArrow" Property="VerticalAlignment" Value="Top" />
                            <Setter TargetName="PART_RectDirectionArrow" Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="0" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="PART_RectDirectionTop" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_RectDirectionHost" Property="VerticalAlignment" Value="Top" />
                            <Setter TargetName="PART_RectDirectionHost" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="PART_RectDirectionHost" Property="Margin" Value="0,-10,0,0" />

                        </Trigger>
                        <Trigger Property="RectDirection" Value="Bottom">
                            <Setter TargetName="FirstRow" Property="Height" Value="8*" />
                            <Setter TargetName="SecondRow" Property="Height" Value="2*" />
                            <Setter TargetName="PART_RectDirectionArrow" Property="Grid.Row" Value="1" />
                            <Setter TargetName="PART_RectDirectionArrow" Property="Grid.Column" Value="0" />
                            <Setter TargetName="PART_RectDirectionArrow" Property="Grid.ColumnSpan" Value="2" />
                            <Setter TargetName="PART_RectDirectionArrow" Property="Margin" Value="0,0,0,-20" />
                            <Setter TargetName="PART_RectDirectionArrow" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="PART_RectDirectionArrow" Property="VerticalAlignment" Value="Bottom" />
                            <Setter TargetName="PART_RectDirectionArrow" Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="PART_RectDirectionBottom" Property="Visibility" Value="Collapsed" />

                            <Setter TargetName="PART_RectDirectionHost" Property="VerticalAlignment" Value="Bottom" />
                            <Setter TargetName="PART_RectDirectionHost" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="PART_RectDirectionHost" Property="Margin" Value="0,0,0,-10" />
                        </Trigger>
                        <Trigger Property="RectDirection" Value="Left">
                            <Setter TargetName="FirstCol" Property="Width" Value="2*" />
                            <Setter TargetName="SecondCol" Property="Width" Value="8*" />
                            <Setter TargetName="PART_RectDirectionArrow" Property="Grid.Row" Value="0" />
                            <Setter TargetName="PART_RectDirectionArrow" Property="Grid.Column" Value="0" />
                            <Setter TargetName="PART_RectDirectionArrow" Property="Grid.RowSpan" Value="2" />
                            <Setter TargetName="PART_RectDirectionArrow" Property="Margin" Value="-20,0,0,0" />
                            <Setter TargetName="PART_RectDirectionArrow" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="PART_RectDirectionArrow" Property="VerticalAlignment" Value="Center" />
                            <Setter TargetName="PART_RectDirectionArrow" Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="PART_RectDirectionLeft" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_RectDirectionHost" Property="VerticalAlignment" Value="Center" />
                            <Setter TargetName="PART_RectDirectionHost" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="PART_RectDirectionHost" Property="Margin" Value="-10,0,0,0" />
                        </Trigger>

                        <Trigger Property="RectDirection" Value="Right">
                            <Setter TargetName="FirstCol" Property="Width" Value="8*" />
                            <Setter TargetName="SecondCol" Property="Width" Value="2*" />
                            <Setter TargetName="PART_RectDirectionArrow" Property="Grid.Row" Value="0" />
                            <Setter TargetName="PART_RectDirectionArrow" Property="Grid.Column" Value="1" />
                            <Setter TargetName="PART_RectDirectionArrow" Property="Grid.RowSpan" Value="2" />
                            <Setter TargetName="PART_RectDirectionArrow" Property="Margin" Value="0,0,-20,0" />
                            <Setter TargetName="PART_RectDirectionArrow" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="PART_RectDirectionArrow" Property="VerticalAlignment" Value="Center" />
                            <Setter TargetName="PART_RectDirectionArrow" Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="PART_RectDirectionRight" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_RectDirectionHost" Property="VerticalAlignment" Value="Center" />
                            <Setter TargetName="PART_RectDirectionHost" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="PART_RectDirectionHost" Property="Margin" Value="0,0,-10,0" />

                        </Trigger>


                        <Trigger SourceName="PART_RectDirectionTop" Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_DirectionPreviewHost" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_DirectionPreviewHost" Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="0" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="PART_DirectionPreviewHost" Property="VerticalAlignment" Value="Top" />
                            <Setter TargetName="PART_DirectionPreviewHost" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="PART_DirectionPreviewHost" Property="Margin" Value="0,-20,0,0" />
                        </Trigger>

                        <Trigger SourceName="PART_RectDirectionBottom" Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_DirectionPreviewHost" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_DirectionPreviewHost" Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="PART_DirectionPreviewHost" Property="VerticalAlignment" Value="Bottom" />
                            <Setter TargetName="PART_DirectionPreviewHost" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="PART_DirectionPreviewHost" Property="Margin" Value="0,0,0,-20" />
                        </Trigger>

                        <Trigger SourceName="PART_RectDirectionLeft" Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_DirectionPreviewHost" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_DirectionPreviewHost" Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="PART_DirectionPreviewHost" Property="VerticalAlignment" Value="Center" />
                            <Setter TargetName="PART_DirectionPreviewHost" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="PART_DirectionPreviewHost" Property="Margin" Value="-20,0,0,0" />
                        </Trigger>

                        <Trigger SourceName="PART_RectDirectionRight" Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_DirectionPreviewHost" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_DirectionPreviewHost" Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="PART_DirectionPreviewHost" Property="VerticalAlignment" Value="Center" />
                            <Setter TargetName="PART_DirectionPreviewHost" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="PART_DirectionPreviewHost" Property="Margin" Value="0,0,-20,0" />
                        </Trigger>

                        <Trigger Property="IsSelect" Value="True">
                            <Setter TargetName="PART_Frame" Property="BorderThickness" Value="2" />
                        </Trigger>

                        <Trigger Property="IsSingleSelect" Value="False">
                            <Setter TargetName="PART_RectDirectionHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
