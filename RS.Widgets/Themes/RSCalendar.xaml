        </DataTemplate.Triggers>
    </DataTemplate>

    <Style TargetType="{x:Type rs:RSCalendar}">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#E5E5E5" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type rs:RSCalendar}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border
                                x:Name="PART_TitleHost"
                                Padding="5"
                                BorderBrush="#EEEEEE"
                                BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="PART_BtnTitle" HorizontalContentAlignment="Left">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource RSApp.Styles.ButtonBaseStyle}" TargetType="{x:Type ButtonBase}">
                                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                <Setter Property="VerticalAlignment" Value="Stretch" />
                                                <Setter Property="FontSize" Value="14" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#fff" />
                                                        <Setter Property="Foreground" Value="#949494" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button
                                            x:Name="PART_PageUp"
                                            Padding="8"
                                            rs:ControlsHelper.IconData="M1370.209524 980.114286c117.028571 0 185.295238-102.4 121.904762-180.419048L897.219048 73.142857c-58.514286-68.266667-190.171429-68.266667-248.685715 0L53.638095 799.695238c-63.390476 78.019048 4.87619 180.419048 121.904762 180.419048h1194.666667z"
                                            rs:ControlsHelper.IconHeight="12"
                                            rs:ControlsHelper.IconWidth="12"
                                            Foreground="#878787"
                                            Style="{StaticResource RSApp.Styles.IconButtonStyle}" />

                                        <Button
                                            x:Name="PART_PageDown"
                                            Padding="8"
                                            rs:ControlsHelper.IconData="M187.12380925 43.885714c-117.028571 0-185.295238 102.4-121.904762 180.419048L660.11428525 950.857143c58.514286 68.266667 190.171429 68.266667 248.685715 0L1503.69523825 224.304762c63.390476-78.019048-4.87619-180.419048-121.90476201-180.419048l-1194.66666699 0z"
                                            rs:ControlsHelper.IconHeight="12"
                                            rs:ControlsHelper.IconWidth="12"
                                            Foreground="#878787"
                                            Style="{StaticResource RSApp.Styles.IconButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid
                                x:Name="PART_DayOfWeekHost"
                                Grid.Row="1"
                                Visibility="Collapsed">
                                <ItemsControl x:Name="PART_DayOfWeek" ItemsSource="{TemplateBinding WeekdayList}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid
                                                Height="{Binding RelativeSource={RelativeSource AncestorType={x:Type rs:RSCalendar}}, Path=DayOfWeekHeight}"
                                                Columns="7"
                                                Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border>
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontWeight="Bold"
                                                    Text="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <ScrollViewer
                                x:Name="PART_ScrollViewer"
                                Grid.Row="2"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden">
                                <Canvas x:Name="PART_Canvas" Background="Transparent" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="CalendarViewType" Value="Day">
                            <Setter TargetName="PART_DayOfWeekHost" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="CalendarViewType" Value="Year">
                            <Setter TargetName="PART_BtnTitle" Property="IsEnabled" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>