            </DataTrigger>


            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type rs:RSCalendar}}, Path=IsGroupLabelVisible}" Value="True" />
                    <Condition Binding="{Binding IsFirstMonthOfYear}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="PART_Year" Property="Visibility" Value="Visible" />
            </MultiDataTrigger>


            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="PART_Ellipse" Property="Stroke" Value="#1A76C6" />
                <Setter TargetName="PART_Ellipse" Property="StrokeThickness" Value="1" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="False">
                <Setter TargetName="PART_Ellipse" Property="Stroke" Value="Transparent" />
                <Setter TargetName="PART_Ellipse" Property="StrokeThickness" Value="1" />
            </DataTrigger>


        </DataTemplate.Triggers>
    </DataTemplate>

