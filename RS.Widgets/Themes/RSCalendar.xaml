                <Setter TargetName="PART_Year" Property="Foreground" Value="#949494" />
            </DataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsCurrentYear}" Value="True" />
                    <Condition Binding="{Binding ElementName=PART_Grid, Path=IsMouseOver}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="PART_Ellipse" Property="Fill" Value="#1A76C6" />
            </MultiDataTrigger>

            <DataTrigger Binding="{Binding IsCurrentYear}" Value="True">
                <Setter TargetName="PART_Year" Property="Foreground" Value="#FFFFFF" />
            </DataTrigger>

