            MaxWidth="60"
            MaxHeight="60"
            Background="Transparent">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                    <i:InvokeCommandAction Command="{Binding CalendarItemClickCommand}" CommandParameter="{Binding}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <Ellipse x:Name="PART_Ellipse" Margin="3" />
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                    x:Name="PART_Year"
                    Margin="0"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Text="{Binding DisplayContent}" />
            </Grid>
        </Grid>
        <DataTemplate.Triggers>
            <Trigger SourceName="PART_Grid" Property="IsMouseOver" Value="True">
                <Setter TargetName="PART_Ellipse" Property="Fill" Value="#F6F6F6" />
            </Trigger>
            <DataTrigger Binding="{Binding IsCurrentYear}" Value="True">
                <Setter TargetName="PART_Ellipse" Property="Fill" Value="#0067C6" />
