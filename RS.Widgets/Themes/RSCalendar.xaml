            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                    x:Name="PART_Month"
                    Margin="0"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Text="{Binding DisplayContent}" />
                <TextBlock
                    x:Name="PART_Year"
                    Margin="0,-12,0,0"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    FontSize="9"
                    Text="{Binding Year}"
                    Visibility="Collapsed" />
            </Grid>

        </Grid>
        <DataTemplate.Triggers>
            <Trigger SourceName="PART_Grid" Property="IsMouseOver" Value="True">
                <Setter TargetName="PART_Ellipse" Property="Fill" Value="#F6F6F6" />
            </Trigger>
            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="True">
                <Setter TargetName="PART_Ellipse" Property="Fill" Value="#0067C6" />
