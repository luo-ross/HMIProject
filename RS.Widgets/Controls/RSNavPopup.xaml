<Window
    x:Class="RS.Widgets.Controls.RSNavPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:RS.Widgets.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rs="clr-namespace:RS.Widgets.Controls"
    mc:Ignorable="d">
    <Window.Resources>
      
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RS.Widgets;component/Styles/Controls.Brush.xaml" />
                <ResourceDictionary Source="pack://application:,,,/RS.Widgets;component/Styles/Controls.Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/RS.Widgets;component/Styles/Controls.Effects.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:ClipConverter x:Key="ClipConverter" />
            <converters:ForegroundColorConverter x:Key="ForegroundColorConverter" />

        </ResourceDictionary>
    </Window.Resources>
    <Window.Style>
        <Style TargetType="{x:Type rs:RSNavPopup}">
            <Setter Property="ResizeMode" Value="CanResize" />
            <Setter Property="Background" Value="#F3F3F3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type rs:RSNavPopup}">
                        <Border Effect="{TemplateBinding Effect}">
                            <Grid x:Name="PART_Border" Margin="15,0,15,15">
                                <Border
                                    Background="#fff"
                                    BorderBrush="{StaticResource RSApp.Styles.BaseGray007}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Effect="{StaticResource RSApp.Styles.DefaultEffect}" />
                                <Grid x:Name="PART_Client">
                                    <AdornerDecorator>
                                        <Grid>
                                            <rs:RSNavList
                                                x:Name="PART_NavList"
                                                rs:ControlsHelper.IconHeight="12"
                                                rs:ControlsHelper.IconWidth="12"
                                                BorderThickness="0"
                                                ItemContainerStyle="{StaticResource RSApp.Styles.NavListBoxItemStyle}"
                                                ItemTemplate="{StaticResource NavPopupDataTemplate}"
                                                ItemsSource="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=NavigateModelList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                                VirtualizingPanel.IsVirtualizing="True" />
                                        </Grid>
                                    </AdornerDecorator>
                                </Grid>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Style>
</Window>
