    <!--  透明/半透明系列（注意：SolidColorBrush 支持 Alpha 通道，直接用 ARGB 格式）  -->
    <SolidColorBrush x:Key="RSApp.Styles.ThemeAlpha005">#0D305BD2</SolidColorBrush>
    <!--  0.05 透明度 = 128*0.05≈6 → 十六进制 0D  -->
    <SolidColorBrush x:Key="RSApp.Styles.ThemeAlpha010">#1A305BD2</SolidColorBrush>
    <!--  0.1 透明度 = 128*0.1≈13 → 十六进制 1A  -->
    <SolidColorBrush x:Key="RSApp.Styles.ThemeAlpha015">#26305BD2</SolidColorBrush>
    <!--  0.15 透明度 = 128*0.15≈19 → 十六进制 26  -->
    <SolidColorBrush x:Key="RSApp.Styles.ThemeAlpha020">#33305BD2</SolidColorBrush>
    <!--  0.2 透明度 = 128*0.2≈26 → 十六进制 33  -->
    <SolidColorBrush x:Key="RSApp.Styles.ThemeAlpha025">#40305BD2</SolidColorBrush>
    <!--  0.25 透明度 = 128*0.25=32 → 十六进制 40  -->
    <SolidColorBrush x:Key="RSApp.Styles.ThemeAlpha030">#4D305BD2</SolidColorBrush>
    <!--  0.3 透明度 = 128*0.3≈38 → 十六进制 4D  -->
    <SolidColorBrush x:Key="RSApp.Styles.ThemeAlpha040">#66305BD2</SolidColorBrush>
    <!--  0.4 透明度 = 128*0.4=51 → 十六进制 66  -->
    <SolidColorBrush x:Key="RSApp.Styles.ThemeAlpha050">#80305BD2</SolidColorBrush>
    <!--  0.5 透明度 = 128*0.5=64 → 十六进制 80  -->
    <SolidColorBrush x:Key="RSApp.Styles.ThemeAlpha060">#99305BD2</SolidColorBrush>
    <!--  0.6 透明度 = 128*0.6≈77 → 十六进制 99  -->
    <SolidColorBrush x:Key="RSApp.Styles.ThemeAlpha070">#B3305BD2</SolidColorBrush>
    <!--  0.7 透明度 = 128*0.7≈90 → 十六进制 B3  -->
    <SolidColorBrush x:Key="RSApp.Styles.ThemeAlpha080">#CC305BD2</SolidColorBrush>
    <!--  0.8 透明度 = 128*0.8=102 → 十六进制 CC  -->
    <SolidColorBrush x:Key="RSApp.Styles.ThemeAlpha090">#E6305BD2</SolidColorBrush>
    <!--  0.9 透明度 = 128*0.9≈115 → 十六进制 E6  -->


